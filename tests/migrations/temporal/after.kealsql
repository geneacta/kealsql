columns Audited { created: Timestamptz = now() }
table Room with Audited { id: Id
    name: Slug }
table Tariff {
    id:     Id
    cascade room: RefId<Room>
    nights: Range<Int>
    noOverlap(room, nights)
}
table Stay {
    id:     Id
    cascade room: RefId<Room>
    nights: Range<Int>
    covered(room, nights) by Tariff(room, nights)
}
