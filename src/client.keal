// The client: a file's queries as a Keal module an application imports,
// each a typed method on a connection, through libpq.
//
//   kealsql --client DIR file.kealsql        writes DIR/<stem>.client.keal
//
//   import "./blog.client.keal"
//   val db = connectBlog("dbname=blog")       // a libpq connection string; PG* and ~/.pgpass apply
//   for (p in db.byAuthor("ada")) { println(p.title) }
//   db.close()
//
//   keal build app.keal -I$(pg_config --includedir) -lpq
//
// The rows are the same records a stored function reads through SPI, the
// wrapper code is the same generator on another bridge: every statement is
// prepared once per connection on first use and run with its parameters as
// text; cells come back as text and are parsed on the Keal side. An error is
// a Keal exception carrying the query's name and the server's message.

import "./ast.keal"
import "./schema.keal"
import "./compile.keal"
import "./plkeal.keal"

func upperFirst(s: String): String { s.take(1).toUpper() + s.drop(1) }

/// A Keal string literal holding `s`.
func kealLiteral(s: String): String {
    var out = "\""
    for (c in s) {
        out += when (c) {
            "\\" -> "\\\\"
            "\"" -> "\\\""
            "\n" -> "\\n"
            "$" -> "\\$"
            else -> c
        }
    }
    return out + "\""
}

package func clientSource(compiler: Compiler): String {
    val program = compiler.program
    val schema = compiler.schema
    val queries = compiler.queries
    val stem = upperFirst(compiler.libStem())
    var out = "// Generated by `kealsql --client` from ${compiler.file}. Do not edit; edit the .kealsql.\n"
    out += "// Build the program that imports it with: keal build app.keal -I$(pg_config --includedir) -lpq\n\n"

    // ---- rows as records, as plkeal makes them
    val rowTables: List<String> = []
    for (q in queries) { if (q.rowTable != "" and not rowTables.contains(q.rowTable)) { rowTables.add(q.rowTable) } }
    out += enumDecls(program, "public ")
    for (tr in program.traits) { out += "public " + tr.text + "\n\n" }
    for (name in rowTables) {
        val t = schema.tables[name]!!
        out += recordDeclOf(name, t.columns.map({ it.name }), t.columns.map({ kealType(it.ty(), schema) }), t.decl.traits, t.decl.methods, "public ")
    }
    for (q in queries) {
        if (q.rowTable == "" and q.colTys.size > 1) {
            out += recordDeclOn(rowRecordOf(q), q.colNames, q.colTys.map({ kealType(it, schema) }))
        }
    }
    out += "\n"

    // ---- the bridge, as seen from Keal
    out += "extern func kcConnect(conninfo: borrow String): Int = \"kealsql_client_connect\"\n"
    out += "extern proc kcClose(handle: Int) = \"kealsql_client_close\"\n"
    out += "extern proc kcArgString(s: borrow String) = \"kealsql_client_arg\"\n"
    out += "extern proc kcArgNull() = \"kealsql_client_arg_null\"\n"
    out += "extern proc kcRun(handle: Int, slot: Int) = \"kealsql_client_run\"\n"
    out += "extern proc kcExec(handle: Int, sql: borrow String) = \"kealsql_client_exec\"\n"
    out += "extern func kcFailed(): Bool = \"kealsql_client_failed\"\n"
    out += "extern func kcMessage(): own String = \"kealsql_client_message\"\n"
    out += "extern func kcState(): own String = \"kealsql_client_state\"\n"
    out += "extern func kcRows(): Int = \"kealsql_client_rows\"\n"
    out += "extern func kcIsNull(row: Int, col: Int): Bool = \"kealsql_client_is_null\"\n"
    out += "extern func kcStr(row: Int, col: Int): own String = \"kealsql_client_str\"\n"
    out += "extern func kcInt(row: Int, col: Int): Int = \"kealsql_client_int\"\n"
    out += "extern func kcFloat(row: Int, col: Int): Float = \"kealsql_client_float\"\n"
    out += "extern func kcBool(row: Int, col: Int): Bool = \"kealsql_client_bool\"\n\n"
    out += "/// A query that failed is a Keal exception: the query's name, and what the server said.\n"
    out += "/// A serialization failure (SQLSTATE 40001) has its own type: `serializable { … }` retries on it.\n"
    out += "public record SerializationFailure(val message: String)\n\n"
    out += "proc kcCheck(what: String) {\n"
    out += "    if (kcFailed()) {\n"
    out += "        if (kcState() == \"40001\") { throw SerializationFailure(what + \": \" + kcMessage()) }\n"
    out += "        throw what + \": \" + kcMessage()\n"
    out += "    }\n"
    out += "}\n\n"

    // ---- the connection, with one method per query
    out += "/// Opens a connection: a libpq connection string (\"dbname=blog host=...\", or \"\" for the PG* environment).\n"
    out += "public func connect${stem}(conninfo: String): ${stem}Db {\n"
    out += "    val h = kcConnect(conninfo)\n"
    out += "    if (h < 0) { throw \"connect: \" + kcMessage() }\n"
    out += "    return ${stem}Db(h)\n"
    out += "}\n\n"
    // ---- the database itself, made from the code when it is missing
    val first = compiler.tableOrder().first()
    out += "/// The database named, made if it is missing — then its schema, if it holds none of\n"
    out += "/// these tables. Stored functions and triggers need their library and are not created here.\n"
    out += "/// `conninfo` says where and as whom, without a database: \"host=... user=...\", or \"\".\n"
    out += "public func create${stem}(conninfo: String, dbname: String): ${stem}Db {\n"
    out += "    val admin = kcConnect(conninfo + \" dbname=postgres\")\n"
    out += "    if (admin < 0) { throw \"create${stem}: \" + kcMessage() }\n"
    out += "    kcExec(admin, \"SELECT 1 FROM pg_database WHERE datname = '\" + dbname.replace(\"'\", \"''\") + \"'\")\n"
    out += "    kcCheck(\"create${stem}\")\n"
    out += "    if (kcRows() == 0) {\n"
    out += "        kcExec(admin, \"CREATE DATABASE \\\"\" + dbname.replace(\"\\\"\", \"\\\"\\\"\") + \"\\\"\")\n"
    out += "        kcCheck(\"create${stem}\")\n"
    out += "    }\n"
    out += "    kcClose(admin)\n"
    out += "    val db = connect${stem}(conninfo + \" dbname=\" + dbname)\n"
    if (first != null) {
        out += "    kcExec(db.handle, \"SELECT to_regclass('${qualName(schema, first).replace("\"", "\\\"")}')\")\n"
        out += "    kcCheck(\"create${stem}\")\n"
        out += "    if (kcIsNull(0, 0)) {\n"
        out += "        kcExec(db.handle, ${kealLiteral(compiler.ddl())})\n"
        out += "        kcCheck(\"create${stem}\")\n"
        out += "    }\n"
    }
    out += "    return db\n"
    out += "}\n\n"
    out += "public class ${stem}Db(val handle: Int) {\n"
    out += "    var depth: Int = 0\n"
    out += "    public proc close() { kcClose(this.handle) }\n"
    out += "    public proc begin() { kcExec(this.handle, \"BEGIN\"); kcCheck(\"begin\") }\n"
    out += "    public proc commit() { kcExec(this.handle, \"COMMIT\"); kcCheck(\"commit\") }\n"
    out += "    public proc rollback() { kcExec(this.handle, \"ROLLBACK\"); kcCheck(\"rollback\") }\n\n"
    out += transactionMethods(stem)
    var slot = 0
    for (q in queries) {
        val w = queryWrapperOn("kc", "this.handle", q, slot, schema)
        // a method: every line of the wrapper indented into the class
        for (l in lines(w)) {
            val line = if (l.startsWith("func ") or l.startsWith("proc ")) { "public " + l } else { l }
            out += if (l == "") { "\n" } else { "    " + line + "\n" }
        }
        slot += 1
    }
    out += "}\n\n"
    out += transactionRunner(stem)

    // ---- the C side
    out += "native \"\"\"\n"
    out += clientBridge(queries)
    out += "\"\"\"\n"
    return out
}

/// `transaction { … }` and `serializable { … }`: a block run in a
/// transaction, committed when it answers, rolled back when it throws.
/// Nested, a block is a savepoint. Serializable blocks are retried when
/// PostgreSQL refuses them as a serialization failure (SQLSTATE 40001).
/// The block itself runs in `kcBlock`, a module-level function and not a
/// method: Keal's native backend does not check the unwind flag after a
/// method call, so a throw out of `this.run(…)` inside `serializable`'s
/// `try` would skip its `catch` and end the program in silence.
func transactionMethods(stem: String): String {
    var out = ""
    out += "    /// Runs `body` in a transaction: `BEGIN`, then `COMMIT` when it answers, `ROLLBACK` —\n"
    out += "    /// and the error thrown on — when it throws. Inside a transaction it is a savepoint:\n"
    out += "    /// an inner failure undoes the inner work only, and the outer block goes on.\n"
    out += "    public func transaction<T>(body: (${stem}Db) -> T): T {\n"
    out += "        return kcBlock(this, \"BEGIN\", body)\n"
    out += "    }\n\n"
    out += "    /// The same at the SERIALIZABLE level, retried — the whole block again — when the\n"
    out += "    /// server refuses it as a serialization failure, which is how that level is used.\n"
    out += "    /// Nested in a transaction it is a savepoint, and the level is the outer block's.\n"
    out += "    public func serializable<T>(body: (${stem}Db) -> T): T {\n"
    out += "        var tries = 0\n"
    out += "        while (tries < 10) {\n"
    out += "            tries += 1\n"
    out += "            try {\n"
    out += "                return kcBlock(this, \"BEGIN ISOLATION LEVEL SERIALIZABLE\", body)\n"
    out += "            } catch (e: SerializationFailure) {\n"
    out += "                if (this.depth > 0 or tries >= 10) { throw e }\n"
    out += "            }\n"
    out += "        }\n"
    out += "        throw \"transaction: gave up after \" + tries + \" serialization failures\"\n"
    out += "    }\n\n"
    out += "    proc nest() { this.depth += 1 }\n"
    out += "    proc unnest() { this.depth -= 1 }\n"
    out += "    proc undo(ending: Bool, inner: Bool, point: String) {\n"
    out += "        if (ending) { return }                     // the COMMIT / RELEASE path has settled already\n"
    out += "        this.depth -= 1\n"
    out += "        kcExec(this.handle, if (inner) { \"ROLLBACK TO SAVEPOINT \" + point } else { \"ROLLBACK\" })\n"
    out += "    }\n\n"
    return out
}

/// The block runner behind `transaction` and `serializable`, at module level: `kcBlock`.
func transactionRunner(stem: String): String {
    var out = ""
    out += "/// A block in a transaction, or in a savepoint when one is open already.\n"
    out += "func kcBlock<T>(db: ${stem}Db, begin: String, body: (${stem}Db) -> T): T {\n"
    out += "    val inner = db.depth > 0\n"
    out += "    val point = \"kealsql_\" + db.depth\n"
    out += "    kcExec(db.handle, if (inner) { \"SAVEPOINT \" + point } else { begin })\n"
    out += "    kcCheck(\"transaction\")\n"
    out += "    db.nest()\n"
    out += "    var ending = false\n"
    out += "    try {\n"
    out += "        val result = body(db)\n"
    out += "        ending = true\n"
    out += "        db.unnest()\n"
    out += "        kcExec(db.handle, if (inner) { \"RELEASE SAVEPOINT \" + point } else { \"COMMIT\" })\n"
    out += "        if (kcFailed()) {\n"
    out += "            val message = kcMessage()\n"
    out += "            val state = kcState()\n"
    out += "            if (inner) { kcExec(db.handle, \"ROLLBACK TO SAVEPOINT \" + point) }   // a COMMIT that fails has rolled back already\n"
    out += "            if (state == \"40001\") { throw SerializationFailure(\"transaction: \" + message) }\n"
    out += "            throw \"transaction: \" + message\n"
    out += "        }\n"
    out += "        return result\n"
    // Keal has no `finally`, and its catch-all binds the message, not the value:
    // the two types the block itself throws are caught whole and rethrown whole,
    // anything else undoes the work and goes on as its message.
    out += "    } catch (e: SerializationFailure) { db.undo(ending, inner, point); throw e }\n"
    out += "      catch (e: String) { db.undo(ending, inner, point); throw e }\n"
    out += "      catch (e) { db.undo(ending, inner, point); throw e }\n"
    out += "}\n\n"
    return out
}

/// A row record, as plkeal declares it.
func recordDeclOn(name: String, fields: List<String>, types: List<String>): String {
    val decl: List<String> = []
    var i = 0
    while (i < fields.size) {
        decl.add("public val ${fields[i]}: ${types[i]}")
        i += 1
    }
    return "public record ${name}(${decl.join(", ")})\n"
}

func rowRecordOf(q: QueryInfo): String { upperFirst(q.name) + "Row" }

func cEscapeC(s: String): String {
    var out = ""
    for (c in s) {
        out += when (c) {
            "\\" -> "\\\\"
            "\"" -> "\\\""
            "\n" -> "\\n"
            else -> c
        }
    }
    return out
}

func clientBridge(queries: List<QueryInfo>): String {
    var out = "#include <libpq-fe.h>\n#include <string.h>\n#include <stdlib.h>\n\n"
    out += "#define KC_NQ ${queries.size.max(1)}\n"
    out += "#define KC_MAXCONN 64\n#define KC_MAXARGS 32\n"
    out += "static const char* kc_sql[KC_NQ] = {\n"
    for (q in queries) { out += "    \"${cEscapeC(q.sql)}\",\n" }
    if (queries.isEmpty()) { out += "    \"\",\n" }
    out += "};\n"
    out += "static const int kc_nargs[KC_NQ] = { ${queries.map({ "" + it.params.size }).join(", ")}${if (queries.isEmpty()) { "0" } else { "" }} };\n"
    out += """static PGconn* kc_conns[KC_MAXCONN];
static bool kc_prepared[KC_MAXCONN][KC_NQ];
static char* kc_args[KC_MAXARGS];
static int kc_argc;
static PGresult* kc_res;
static char* kc_err;

static char kc_state[6] = "";          /* the SQLSTATE of the last error, "" when it had none */
static void kc_set_state(PGresult* r) {
    const char* st = PQresultErrorField(r, PG_DIAG_SQLSTATE);
    snprintf(kc_state, sizeof kc_state, "%s", st ? st : "");
}
static void kc_set_error(const char* m) {
    free(kc_err);
    kc_err = strdup(m ? m : "error");
    kc_state[0] = 0;
    size_t n = strlen(kc_err);
    while (n > 0 && (kc_err[n - 1] == '\n' || kc_err[n - 1] == ' ')) { kc_err[--n] = 0; }
}

static void kc_reset_args(void) {
    for (int k = 0; k < kc_argc; k++) { free(kc_args[k]); kc_args[k] = NULL; }
    kc_argc = 0;
}

int64_t kealsql_client_connect(const char* conninfo) {
    free(kc_err); kc_err = NULL;
    int h = -1;
    for (int k = 0; k < KC_MAXCONN; k++) { if (kc_conns[k] == NULL) { h = k; break; } }
    if (h < 0) { kc_set_error("too many connections open"); return -1; }
    PGconn* c = PQconnectdb(conninfo);
    if (PQstatus(c) != CONNECTION_OK) { kc_set_error(PQerrorMessage(c)); PQfinish(c); return -1; }
    kc_conns[h] = c;
    memset(kc_prepared[h], 0, sizeof(kc_prepared[h]));
    return h;
}

void kealsql_client_close(int64_t h) {
    if (h < 0 || h >= KC_MAXCONN || kc_conns[h] == NULL) { return; }
    PQfinish(kc_conns[h]);
    kc_conns[h] = NULL;
}

void kealsql_client_arg(const char* s) { if (kc_argc < KC_MAXARGS) { kc_args[kc_argc] = strdup(s); } kc_argc++; }
void kealsql_client_arg_null(void) { if (kc_argc < KC_MAXARGS) { kc_args[kc_argc] = NULL; } kc_argc++; }

static bool kc_ok(PGresult* r) {
    ExecStatusType st = PQresultStatus(r);
    return st == PGRES_TUPLES_OK || st == PGRES_COMMAND_OK;
}

void kealsql_client_run(int64_t h, int64_t slot) {
    if (kc_res) { PQclear(kc_res); kc_res = NULL; }
    free(kc_err); kc_err = NULL;
    if (h < 0 || h >= KC_MAXCONN || kc_conns[h] == NULL) { kc_set_error("no such connection"); kc_reset_args(); return; }
    if (slot < 0 || slot >= KC_NQ) { kc_set_error("no such query"); kc_reset_args(); return; }
    if (kc_argc != kc_nargs[slot]) { kc_set_error("wrong number of arguments"); kc_reset_args(); return; }
    PGconn* c = kc_conns[h];
    char name[32];
    snprintf(name, sizeof name, "kealsql_%d", (int)slot);
    if (!kc_prepared[h][slot]) {
        PGresult* p = PQprepare(c, name, kc_sql[slot], kc_nargs[slot], NULL);
        if (!kc_ok(p)) { kc_set_error(PQresultErrorMessage(p)); kc_set_state(p); PQclear(p); kc_reset_args(); return; }
        PQclear(p);
        kc_prepared[h][slot] = true;
    }
    kc_res = PQexecPrepared(c, name, kc_argc, (const char* const*)kc_args, NULL, NULL, 0);
    if (!kc_ok(kc_res)) { kc_set_error(PQresultErrorMessage(kc_res)); kc_set_state(kc_res); PQclear(kc_res); kc_res = NULL; }
    kc_reset_args();
}

void kealsql_client_exec(int64_t h, const char* sql) {
    if (kc_res) { PQclear(kc_res); kc_res = NULL; }
    free(kc_err); kc_err = NULL;
    if (h < 0 || h >= KC_MAXCONN || kc_conns[h] == NULL) { kc_set_error("no such connection"); return; }
    kc_res = PQexec(kc_conns[h], sql);
    if (!kc_ok(kc_res)) { kc_set_error(PQresultErrorMessage(kc_res)); kc_set_state(kc_res); PQclear(kc_res); kc_res = NULL; }
}

bool kealsql_client_failed(void) { return kc_err != NULL; }
char* kealsql_client_message(void) { return strdup(kc_err ? kc_err : ""); }
char* kealsql_client_state(void) { return strdup(kc_state); }
int64_t kealsql_client_rows(void) {
    if (!kc_res) { return 0; }
    if (PQresultStatus(kc_res) == PGRES_TUPLES_OK) { return PQntuples(kc_res); }
    const char* n = PQcmdTuples(kc_res);
    return (n && *n) ? strtoll(n, NULL, 10) : 0;
}
static const char* kc_cell(int64_t r, int64_t c) {
    if (!kc_res || r < 0 || r >= PQntuples(kc_res) || c < 0 || c >= PQnfields(kc_res)) { return NULL; }
    if (PQgetisnull(kc_res, (int)r, (int)c)) { return NULL; }
    return PQgetvalue(kc_res, (int)r, (int)c);
}
bool kealsql_client_is_null(int64_t r, int64_t c) { return kc_cell(r, c) == NULL; }
char* kealsql_client_str(int64_t r, int64_t c) { const char* v = kc_cell(r, c); return strdup(v ? v : ""); }
int64_t kealsql_client_int(int64_t r, int64_t c) { const char* v = kc_cell(r, c); return v ? strtoll(v, NULL, 10) : 0; }
double kealsql_client_float(int64_t r, int64_t c) { const char* v = kc_cell(r, c); return v ? strtod(v, NULL) : 0.0; }
bool kealsql_client_bool(int64_t r, int64_t c) { const char* v = kc_cell(r, c); return v && v[0] == 't'; }
"""
    return out
}

/// Writes DIR/<stem>.client.keal; answers its path.
package func writeClient(compiler: Compiler, dir: String): String {
    if (compiler.queries.isEmpty()) {
        println("error: ${compiler.file} declares no query")
        exit(1)
    }
    unless (makeDir(dir)) {
        println("error: cannot create `${dir}`")
        exit(1)
    }
    val path = "${dir}/${compiler.libStem()}.client.keal"
    unless (writeFile(path, clientSource(compiler))) {
        println("error: cannot write `${path}`")
        exit(1)
    }
    return path
}
