// kealsql — the KealSql compiler.
//
//   keal src/main.keal file.kealsql                       the SQL: schema, then one PREPARE per func / proc
//   keal src/main.keal --migrate file.kealsql [--db NAME] [--destructive]
//                                                          the migration from a live database to the file
//   keal src/main.keal --plkeal DIR file.kealsql            the stored functions as a Keal program and a
//                                                          build script for the PostgreSQL shared library
//   keal src/main.keal --lib PATH file.kealsql             the SQL, with CREATE FUNCTION naming that library
//   keal src/main.keal --client DIR file.kealsql            the queries as a Keal module over libpq
//   keal src/main.keal --schema file.kealsql                only the CREATEs: enums, tables, views
//   keal src/main.keal --queries file.kealsql               only what a session loads: functions and PREPAREs
//
// `--migrate` reads the database through `psql`; `--db` is psql's `-d`, and
// without it the PG* environment and ~/.pgpass decide, as for psql itself.
// Destructive statements are held back as comments unless `--destructive`.
// Errors go to standard output as `error file:L:C ...` and exit 1, the way
// Keal reports its own.

import "./parser.keal"
import "./compile.keal"
import "./migrate.keal"
import "./plkeal.keal"
import "./client.keal"

func usage(): Nothing {
    println("usage: kealsql <file.kealsql>")
    println("       kealsql --migrate <file.kealsql> [--db NAME] [--destructive]")
    println("       kealsql --plkeal DIR <file.kealsql>")
    println("       kealsql --lib PATH <file.kealsql>")
    println("       kealsql --client DIR <file.kealsql>")
    println("       kealsql --schema <file.kealsql>        the CREATEs only")
    println("       kealsql --queries <file.kealsql>       the functions and PREPAREs only")
    exit(2)
}

var path = ""
var migrate = false
var destructive = false
var db = ""
var plkealDir = ""
var clientDir = ""
var onlySchema = false
var onlyQueries = false
var lib = ""
val argv = args()
var i = 0
while (i < argv.size) {
    val a = argv[i]
    when (a) {
        "--migrate" -> { migrate = true }
        "--destructive" -> { destructive = true }
        "--schema" -> { onlySchema = true }
        "--queries" -> { onlyQueries = true }
        "--db" -> {
            i += 1
            if (i >= argv.size) { usage() }
            db = argv[i]
        }
        "--plkeal" -> {
            i += 1
            if (i >= argv.size) { usage() }
            plkealDir = argv[i]
        }
        "--client" -> {
            i += 1
            if (i >= argv.size) { usage() }
            clientDir = argv[i]
        }
        "--lib" -> {
            i += 1
            if (i >= argv.size) { usage() }
            lib = argv[i]
        }
        else -> {
            if (a.startsWith("--") or path != "") { usage() }
            path = a
        }
    }
    i += 1
}
if (path == "") { usage() }
if (destructive and not migrate) { usage() }
if (onlySchema and onlyQueries) { usage() }

val source = readFile(path)
if (source == null) {
    println("error: cannot read `${path}`")
    exit(1)
}
// A file checked out with CRLF (Windows' git default) reads as LF: the
// lexer already treats `\r` as blank, but a stored function's body is
// sliced out of the source as text, and would carry the `\r` into the
// generated program.
val program = parseFile(path, source.replace("\r\n", "\n"))
val compiler = Compiler(path, program)
compiler.lib = lib
if (clientDir != "") {
    compiler.compile()
    println(writeClient(compiler, clientDir))
} else if (plkealDir != "") {
    compiler.compile()                       // checks everything and records the queries
    for (w in writePlkeal(compiler, plkealDir)) { println(w) }
} else if (migrate) {
    compiler.resolveSchema()
    print(Migration(compiler, readLive(db, schemaRaw(compiler.schema)), destructive).run())
} else {
    print(compiler.compileParts(not onlyQueries, not onlySchema))
}
