// The KealSql parser. Items are KealSql's own — `table`, `enum`, `func` /
// `proc` with a pipeline body — and expressions follow Keal's precedence,
// tightest binding last:
//
//     not and or xor xnor nand nor implies
//     ==  !=  ===  !==  <==>   <  <=  >  >=   in   ?:
//     +  -   *  /  %   unary -   . ?. ()
//
// The connectives share one level and refuse to mix without parentheses,
// as in Keal. A pipeline is parsed as an ordinary method chain; the checker
// is what recognises `from(...)...select(...)` in it.
//
// Failure is loud: print `error L:C message` and stop, the way Keal does.
//
// The lexer is Keal's own, imported from the pinned dependency. KealSql's
// three lexical additions are read here on top of Keal's tokens: `===` and
// `!==` are `==` / `!=` with an adjacent `=`, and `unknown` is the identifier
// in value position (and refused as a name).

import "dep:keal/selfhost/lexing.keal"
import "./ast.keal"

/// How many bytes a character occupies in UTF-8 — the unit Keal's lexer
/// counts columns in.
func byteWidth(c: String): Int {
    val n = c.code()
    if (n < 128) { return 1 }
    if (n < 2048) { return 2 }
    if (n < 65536) { return 3 }
    return 4
}

func describeKind(kind: String): String {
    return when (kind) {
        "eof" -> "end of file"
        ";" -> "end of statement"
        "ident" -> "a name"
        else -> "`${kind}`"
    }
}

func isConnective(kind: String): Bool {
    return when (kind) {
        "and", "or", "xor", "xnor", "nand", "nor", "implies" -> true
        else -> false
    }
}

/// Binding power of a binary operator token; 0 when it is not one.
func powerOf(kind: String): Int {
    return when (kind) {
        "and", "or", "xor", "xnor", "nand", "nor", "implies" -> 1
        "==", "!=", "===", "!==", "<==>" -> 2
        "<", "<=", ">", ">=", "<=>" -> 3
        "in" -> 4
        "?:" -> 5
        "+", "-" -> 7
        "*", "/", "%" -> 8
        else -> 0
    }
}

/// The words that introduce a declaration when a name follows. They stay
/// ordinary names everywhere else — Keal's rule for `record` and `weak`.
func isModifier(w: String): Bool {
    return when (w) {
        "primary", "slug", "unique", "cascade", "restrict", "setNull", "indexed" -> true
        else -> false
    }
}

package class Parser(val toks: List<Token>, val file: String, val source: String) {
    var pos: Int = 0
    var lineStarts: List<Int> = []          // char offset of each line's first character

    func peek(): Token { this.toks[this.pos.min(this.toks.size - 1)] }
    func peekAt(k: Int): Token { this.toks[(this.pos + k).min(this.toks.size - 1)] }
    func at(kind: String): Bool { this.peek().kind == kind }
    func atWord(w: String): Bool { this.at("ident") and this.peek().text == w }

    func advance(): Token {
        val t = this.peek()
        if (this.pos < this.toks.size - 1) { this.pos += 1 }
        return t
    }

    func eat(kind: String): Bool {
        if (this.at(kind)) { this.advance(); return true }
        return false
    }

    proc fail(line: Int, col: Int, msg: String) {
        println("error ${this.file}:${line}:${col} ${msg}")
        exit(1)
    }

    proc failHere(msg: String) {
        val t = this.peek()
        this.fail(t.line, t.col, msg)
    }

    proc expect(kind: String, ctx: String) {
        if (this.eat(kind)) { return }
        this.failHere("expected ${describeKind(kind)} ${ctx}, found ${describeToken(this.peek())}")
    }

    func expectIdent(ctx: String): String {
        if (this.at("ident")) { return this.advance().text }
        this.failHere("expected ${ctx}, found ${describeToken(this.peek())}")
        return ""
    }

    proc skipSemis() { while (this.at(";")) { this.advance() } }

    // ---- items --------------------------------------------------------

    func program(): ProgramN {
        val p = ProgramN()
        this.skipSemis()
        while (not this.at("eof")) {
            if (this.at("import")) {
                this.advance()
                if (not this.at("str")) { this.failHere("expected a path after `import`") }
                p.imports.add(this.advance().text)
            } else if (this.atWord("schema") and this.peekAt(1).kind == "ident") {
                val t = this.advance()
                if (p.schema != "") { this.fail(t.line, t.col, "one `schema` per file") }
                if (not p.tables.isEmpty() or not p.enums.isEmpty()) { this.fail(t.line, t.col, "`schema` comes before the tables") }
                p.schema = this.expectIdent("a name after `schema`")
            } else if (this.atWord("table") and this.peekAt(1).kind == "ident") {
                p.tables.add(this.tableDecl())
            } else if (this.atWord("renamed") and this.peekAt(1).kind == "(") {
                val old = this.renamed()
                unless (this.atWord("table")) { this.failHere("`renamed(...)` at the top level goes before `table`") }
                val t = this.tableDecl()
                t.renamedFrom = old
                p.tables.add(t)
            } else if (this.atWord("enum") and this.peekAt(1).kind == "ident") {
                p.enums.add(this.enumDecl())
            } else if ((this.atWord("view") and this.peekAt(1).kind == "ident") or (this.atWord("materialized") and this.peekAt(1).kind == "ident" and this.peekAt(1).text == "view")) {
                val t = this.advance()
                var materialized = false
                if (t.text == "materialized") { this.advance(); materialized = true }
                val name = this.expectIdent("a name after `view`")
                this.expect("{", "to open the view's query")
                this.skipSemis()
                val body = this.expr()
                this.skipSemis()
                this.expect("}", "to close the view")
                val v = ViewN(name, body, t.line, t.col)
                v.materialized = materialized
                p.views.add(v)
            } else if (this.atWord("trigger") and this.peekAt(1).kind == "ident") {
                p.triggers.add(this.triggerDecl())
            } else if (this.atWord("stored") and (this.peekAt(1).kind == "func" or this.peekAt(1).kind == "proc" or (this.peekAt(1).kind == "ident" and this.peekAt(1).text == "pure"))) {
                p.stored.add(this.storedDecl())
            } else if (this.at("func")) {
                p.funs.add(this.funDecl(true))
            } else if (this.at("proc")) {
                p.funs.add(this.funDecl(false))
            } else {
                this.failHere("expected `table`, `enum`, `func`, `proc` or `import`, found ${describeToken(this.peek())}")
            }
            this.skipSemis()
        }
        return p
    }

    func enumDecl(): EnumN {
        val t = this.advance()                                 // `enum`
        val e = EnumN(this.expectIdent("a name after `enum`"), t.line, t.col)
        this.expect("{", "after the enum's name")
        this.skipSemis()
        while (not this.at("}")) {
            e.values.add(this.expectIdent("a value name"))
            this.skipSemis()
            if (not this.eat(",")) { this.skipSemis(); break }
            this.skipSemis()
        }
        this.expect("}", "to close the enum")
        return e
    }

    func tableDecl(): TableN {
        val t = this.advance()                                 // `table`
        val tab = TableN(this.expectIdent("a name after `table`"), t.line, t.col)
        this.expect("{", "after the table's name")
        this.skipSemis()
        while (not this.at("}")) {
            if (this.atWord("unique") and this.peekAt(1).kind == "(") {
                tab.uniques.add(this.uniqueConstraint())
            } else if (this.atWord("index") and this.peekAt(1).kind == "(") {
                tab.indexes.add(this.columnList("index"))
            } else if (this.atWord("check") and this.peekAt(1).kind == "ident" and this.peekAt(2).kind == "(") {
                val t = this.advance()
                val name = this.advance().text
                this.expect("(", "after the check's name")
                val ex = this.expr()
                this.expect(")", "to close the check")
                tab.checks.add(CheckN(name, ex, t.line, t.col))
            } else if (this.atWord("check")) {
                this.failHere("a check has a name: `check nonNegative(stock >= 0)`")
            } else {
                tab.columns.add(this.column())
            }
            // A column ends with its type, and `>` does not end a statement
            // for Keal's lexer; the next column's name is separator enough.
            this.skipSemis()
        }
        this.expect("}", "to close the table")
        return tab
    }

    func uniqueConstraint(): List<String> {
        val t = this.peek()
        val names = this.columnList("unique")
        if (names.size < 2) {
            this.fail(t.line, t.col, "`unique(...)` on one column is written as a modifier: `unique ${names[0]}: ...`")
        }
        return names
    }

    /// `word(a, b, ...)`: the column names.
    func columnList(word: String): List<String> {
        this.advance()
        this.expect("(", "after `${word}`")
        val names: List<String> = []
        names.add(this.expectIdent("a column name"))
        while (this.eat(",")) { names.add(this.expectIdent("a column name")) }
        this.expect(")", "to close `${word}(`")
        return names
    }

    /// `renamed(old)`: the previous name, for the migration that renames it.
    func renamed(): String {
        this.advance()                                         // `renamed`
        this.expect("(", "after `renamed`")
        val old = this.expectIdent("the previous name")
        this.expect(")", "to close `renamed(`")
        return old
    }

    func column(): ColumnN {
        val mods: List<String> = []
        var renamedFrom = ""
        while (this.at("ident")) {
            if (isModifier(this.peek().text) and this.peekAt(1).kind == "ident") {
                mods.add(this.advance().text)
            } else if (this.peek().text == "renamed" and this.peekAt(1).kind == "(") {
                if (renamedFrom != "") { this.failHere("`renamed` is written twice") }
                renamedFrom = this.renamed()
            } else {
                break
            }
        }
        val t = this.peek()
        val name = this.expectIdent("a column name")
        if (name == "unknown") { this.fail(t.line, t.col, "`unknown` is the third value of a `Bool3`; it cannot name a column") }
        this.expect(":", "after the column's name")
        val c = ColumnN(name, this.typeExpr(), t.line, t.col)
        c.mods = mods
        c.renamedFrom = renamedFrom
        if (this.eat("=")) { c.default = this.expr() }
        return c
    }

    func funDecl(isFunc: Bool): FunN {
        val t = this.advance()                                 // `func` / `proc`
        val word = if (isFunc) { "func" } else { "proc" }
        val f = FunN(this.expectIdent("a name after `${word}`"), isFunc, t.line, t.col)
        this.expect("(", "after the ${word}'s name")
        if (not this.at(")")) {
            f.params.add(this.param())
            while (this.eat(",")) { f.params.add(this.param()) }
        }
        this.expect(")", "to close the parameter list")
        if (isFunc) {
            this.expect(":", "before a `func`'s result type")
            f.ret = this.typeExpr()
        } else if (this.at(":")) {
            this.failHere("a `proc` returns nothing; a query that answers something is a `func`")
        }
        this.expect("{", "to open the body")
        this.skipSemis()
        while (this.at("val")) {
            val vt = this.advance()
            val name = this.expectIdent("a name after `val`")
            this.expect("=", "after the name")
            f.bindings.add(BindN(name, this.expr(), vt.line, vt.col))
            this.expect(";", "after the binding")
            this.skipSemis()
        }
        if (this.at("}")) { this.failHere("the body ends without a query") }
        f.body = this.expr()
        this.skipSemis()
        this.expect("}", "to close the body")
        return f
    }

    /// `stored [pure] func name(params): Ret { ...Keal... }` — the signature is
    /// parsed; the body is sliced out of the source by its braces and kept
    /// as text for the Keal toolchain.
    func storedDecl(): StoredN {
        val t = this.advance()                                 // `stored`
        var pure = false
        if (this.atWord("pure")) { this.advance(); pure = true }
        if (this.at("proc")) { this.failHere("a stored function answers SQL something; write `stored func ...: Type`") }
        this.expect("func", "after `stored`")
        val s = StoredN(this.expectIdent("a name after `stored func`"), t.line, t.col)
        s.pure = pure
        this.expect("(", "after the function's name")
        if (not this.at(")")) {
            s.params.add(this.param())
            while (this.eat(",")) { s.params.add(this.param()) }
        }
        this.expect(")", "to close the parameter list")
        this.expect(":", "before a stored function's result type")
        s.ret = this.typeExpr()
        if (not this.at("{")) { this.failHere("expected `{` to open the body, found ${describeToken(this.peek())}") }
        s.body = this.rawBody()
        return s
    }

    /// `trigger name on Table before|after insert|update|delete { ...Keal... }`.
    func triggerDecl(): TriggerN {
        val t = this.advance()                                 // `trigger`
        val name = this.expectIdent("a name after `trigger`")
        unless (this.atWord("on")) { this.failHere("expected `on Table` after the trigger's name") }
        this.advance()
        val table = this.expectIdent("a table after `on`")
        val tr = TriggerN(name, table, t.line, t.col)
        if (this.atWord("before") or this.atWord("after")) { tr.timing = this.advance().text }
        else { this.failHere("expected `before` or `after`") }
        if (this.atWord("insert") or this.atWord("update") or this.atWord("delete")) { tr.event = this.advance().text }
        else { this.failHere("expected `insert`, `update` or `delete`") }
        if (not this.at("{")) { this.failHere("expected `{` to open the trigger's body, found ${describeToken(this.peek())}") }
        tr.body = this.rawBody()
        return tr
    }

    /// The text between the `{` ahead and its matching `}`, both consumed.
    func rawBody(): String {
        val open = this.advance()
        var depth = 1
        while (depth > 0) {
            if (this.at("eof")) { this.fail(open.line, open.col, "the body opened here never closes") }
            val k = this.advance().kind
            if (k == "{") { depth += 1 }
            if (k == "}") { depth -= 1 }
        }
        val close = this.toks[this.pos - 1]
        return this.source.substring(this.offsetOf(open.line, open.col) + 1, this.offsetOf(close.line, close.col))
    }

    /// The character offset of a token: the lexer counts columns in bytes.
    func offsetOf(line: Int, col: Int): Int {
        if (this.lineStarts.isEmpty()) {
            var at = 0
            for (l in lines(this.source)) {
                this.lineStarts.add(at)
                at += l.length + 1
            }
            this.lineStarts.add(at)
        }
        val start = this.lineStarts[(line - 1).min(this.lineStarts.size - 1)]
        val text = lines(this.source)[(line - 1).min(this.lineStarts.size - 2)]
        var bytes = 1
        var chars = 0
        for (c in text) {
            if (bytes >= col) { break }
            bytes += byteWidth(c)
            chars += 1
        }
        return start + chars
    }

    func param(): ParamN {
        val t = this.peek()
        val name = this.expectIdent("a parameter name")
        if (name == "unknown") { this.fail(t.line, t.col, "`unknown` is the third value of a `Bool3`; it cannot name a parameter") }
        this.expect(":", "after the parameter's name")
        return ParamN(name, this.typeExpr(), t.line, t.col)
    }

    // ---- types --------------------------------------------------------

    func typeExpr(): TypeN {
        val t = this.peek()
        var ty = TypeN("", t.line, t.col)
        if (this.at("(")) {
            this.advance()
            ty = TypeN("tuple", t.line, t.col)
            ty.args.add(this.typeExpr())
            while (this.eat(",")) { ty.args.add(this.typeExpr()) }
            if (ty.args.size < 2) { this.fail(t.line, t.col, "a tuple type has at least two members") }
            this.expect(")", "to close the tuple type")
        } else {
            val name = this.expectIdent("a type")
            ty = TypeN(name, t.line, t.col)
            when (name) {
                "RefId", "RefSlug" -> {
                    this.expect("<", "after `${name}`")
                    ty.refTable = this.expectIdent("a table name")
                    this.expect(">", "to close `${name}<`")
                }
                "Ref" -> {
                    this.expect("<", "after `Ref`")
                    ty.refTable = this.expectIdent("a table name")
                    this.expect(".", "between the table and its column: `Ref<Table.column>`")
                    ty.refColumn = this.expectIdent("a column name")
                    this.expect(">", "to close `Ref<`")
                }
                "List" -> {
                    this.expect("<", "after `List`")
                    ty.args.add(this.typeExpr())
                    this.expect(">", "to close `List<`")
                }
                "String" -> {
                    if (this.eat("(")) {
                        if (not this.at("int")) { this.failHere("expected a length inside `String(`") }
                        ty.len = this.advance().text.toInt() ?: 0
                        this.expect(")", "to close `String(`")
                    }
                }
                "Decimal" -> {
                    if (this.eat("(")) {
                        if (not this.at("int")) { this.failHere("expected a precision inside `Decimal(`") }
                        ty.len = this.advance().text.toInt() ?: 0
                        this.expect(",", "between precision and scale: `Decimal(10, 2)`")
                        if (not this.at("int")) { this.failHere("expected a scale inside `Decimal(`") }
                        ty.scale = this.advance().text.toInt() ?: 0
                        this.expect(")", "to close `Decimal(`")
                    }
                }
                else -> {}
            }
        }
        if (this.eat("?")) { ty.optional = true }
        return ty
    }

    // ---- expressions --------------------------------------------------

    func expr(): Ex { this.binary(1, "") }

    /// The operator ahead, with `===` / `!==` read as `==` / `!=` and an
    /// adjacent `=` — Keal's lexer does not know them.
    func operatorAhead(): String {
        val t = this.peek()
        if ((t.kind == "==" or t.kind == "!=") and this.peekAt(1).kind == "=" and this.peekAt(1).line == t.line and this.peekAt(1).col == t.col + 2) {
            return t.kind + "="
        }
        return t.kind
    }

    func binary(minPower: Int, prevConnective: String): Ex {
        var left = this.unary()
        var seen = prevConnective
        while (true) {
            val t = this.peek()
            val op = this.operatorAhead()
            val p = powerOf(op)
            if (p == 0 or p < minPower) { break }
            this.advance()
            if (op == "===" or op == "!==") { this.advance() }
            if (isConnective(op)) {
                if (seen != "" and seen != op) {
                    this.fail(t.line, t.col, "`${seen}` and `${op}` need parentheses to say which applies first")
                }
                seen = op
            }
            // `?:` is right-associative; everything else groups to the left.
            val right = if (op == "?:") { this.binary(p, seen) } else { this.binary(p + 1, seen) }
            val kind = when (op) {
                "?:" -> "elvis"
                else -> if (isConnective(op)) { "logical" } else { "binary" }
            }
            val e = Ex(kind, t.line, t.col)
            e.text = op
            e.kids = [left, right]
            left = e
        }
        return left
    }

    func unary(): Ex {
        val t = this.peek()
        if (this.at("-") or this.at("not") or this.at("!")) {
            this.advance()
            val e = Ex("unary", t.line, t.col)
            e.text = if (t.kind == "-") { "-" } else { "not" }
            e.kids = [this.unary()]
            return e
        }
        return this.postfix()
    }

    func postfix(): Ex {
        var e = this.primary()
        while (true) {
            // A chain may continue on the next line: `from(T)` newline `.where(...)`.
            // The lexer ends the statement at the newline; a `.` right after
            // says it was one expression after all.
            if (this.at(";") and this.peekAt(1).kind == ".") { this.advance() }
            val t = this.peek()
            if (this.at(".") or this.at("?.")) {
                this.advance()
                // `unless` is a Keal keyword and a KealSql stage: after a `.` it is a name.
                val name = if (this.at("unless")) { this.advance().kind } else { this.expectIdent("a name after `${t.kind}`") }
                val kind = if (this.at("(")) { "method" } else { "field" }
                val n = Ex(kind, t.line, t.col)
                n.text = name
                n.safe = t.kind == "?."
                n.kids = [e]
                if (kind == "method") { n.args = this.argList() }
                e = n
            } else if (this.at("!!")) {
                this.advance()
                val n = Ex("notnull", t.line, t.col)
                n.kids = [e]
                e = n
            } else {
                break
            }
        }
        return e
    }

    /// `( args )` — positional, then named (`name = value`); a bare `*`;
    /// `Table as alias`.
    func argList(): List<ArgN> {
        this.expect("(", "to open the arguments")
        val out: List<ArgN> = []
        var named = false
        while (not this.at(")")) {
            val t = this.peek()
            if (this.at("*") and (this.peekAt(1).kind == ")" or this.peekAt(1).kind == ",")) {
                this.advance()
                out.add(ArgN("", Ex("star", t.line, t.col)))
            } else if (this.at("ident") and this.peekAt(1).kind == "=" ) {
                named = true
                val name = this.advance().text
                this.advance()
                out.add(ArgN(name, this.expr()))
            } else if (this.at("ident") and this.peekAt(1).kind == "ident" and this.peekAt(1).text == "as") {
                val table = this.advance().text
                this.advance()
                val a = Ex("alias", t.line, t.col)
                a.text = table
                a.iVal = 0
                val al = Ex("ident", this.peek().line, this.peek().col)
                al.text = this.expectIdent("an alias after `as`")
                a.kids = [al]
                out.add(ArgN("", a))
            } else {
                if (named) { this.fail(t.line, t.col, "a positional argument cannot follow a named one") }
                var ex = this.expr()
                if (this.atWord("as")) {
                    // `expr as name`: the column's name in a select.
                    val at = this.advance()
                    val n = Ex("named", at.line, at.col)
                    n.text = this.expectIdent("a name after `as`")
                    n.kids = [ex]
                    ex = n
                }
                out.add(ArgN("", ex))
            }
            if (not this.eat(",")) { break }
        }
        this.expect(")", "to close the arguments")
        return out
    }

    func primary(): Ex {
        val t = this.peek()
        when (t.kind) {
            "int" -> {
                this.advance()
                val e = Ex("int", t.line, t.col)
                e.iVal = t.text.toInt() ?: 0
                e.text = t.text
                return e
            }
            "float" -> {
                this.advance()
                val e = Ex("float", t.line, t.col)
                e.text = t.text
                return e
            }
            "str" -> {
                this.advance()
                if (t.parts.size > 1 or (t.parts.size == 1 and not t.parts[0].isLit)) {
                    this.fail(t.line, t.col, "a query string is a literal; interpolation would be text substitution — pass a parameter instead")
                }
                val e = Ex("str", t.line, t.col)
                // A literal's text lives in its single part; an empty string has none.
                e.text = if (t.parts.size == 1) { t.parts[0].text } else { "" }
                return e
            }
            "true", "false" -> {
                this.advance()
                val e = Ex("bool", t.line, t.col)
                e.text = t.kind
                return e
            }
            "null" -> { this.advance(); return Ex("null", t.line, t.col) }
            "less", "equal", "greater" -> {
                this.advance()
                val e = Ex("comp", t.line, t.col)
                e.text = t.kind
                return e
            }
            "ident" -> {
                this.advance()
                if (t.text == "unknown") { return Ex("unknown", t.line, t.col) }
                if (this.at("(")) {
                    val e = Ex("call", t.line, t.col)
                    e.text = t.text
                    e.args = this.argList()
                    return e
                }
                val e = Ex("ident", t.line, t.col)
                e.text = t.text
                return e
            }
            "(" -> {
                this.advance()
                val e = this.expr()
                this.expect(")", "to close the parenthesis")
                return e
            }
            "[" -> {
                this.advance()
                val e = Ex("list", t.line, t.col)
                while (not this.at("]")) {
                    e.kids.add(this.expr())
                    if (not this.eat(",")) { break }
                }
                this.expect("]", "to close the list")
                return e
            }
            "when" -> { return this.whenExpr() }
            else -> {
                this.failHere("expected an expression, found ${describeToken(t)}")
                return Ex("null", t.line, t.col)
            }
        }
    }

    func whenExpr(): Ex {
        val t = this.advance()                                 // `when`
        val e = Ex("when", t.line, t.col)
        if (this.eat("(")) {
            e.subject = this.expr()
            this.expect(")", "to close the subject")
        }
        this.expect("{", "to open the `when`")
        this.skipSemis()
        while (not this.at("}")) {
            val at = this.peek()
            val arm = ArmN(at.line, at.col)
            if (this.at("else")) {
                this.advance()
                arm.isElse = true
            } else {
                arm.values.add(this.expr())
                while (this.eat(",")) { arm.values.add(this.expr()) }
            }
            this.expect("->", "after the arm's pattern")
            arm.body = this.expr()
            e.arms.add(arm)
            this.skipSemis()
        }
        this.expect("}", "to close the `when`")
        return e
    }
}

package func parseFile(path: String, source: String): ProgramN {
    lexErrorPrefix = "${path}:"
    return Parser(lexFile(source), path, source).program()
}
