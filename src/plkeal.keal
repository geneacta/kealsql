// plkeal: the stored functions of a file as a PostgreSQL shared library.
//
// `kealsql --plkeal DIR file.kealsql` writes DIR/<stem>.keal — a Keal
// program holding the stored functions verbatim, a guard around each that
// turns a panic into a message, a typed Keal wrapper for every query of
// the file (so a stored function calls `byAuthor(name)` and gets a
// `List<(Int, String)>`), and a `native` block with the PostgreSQL entry
// points and the SPI bridge — plus DIR/build.sh, which runs `keal emit-c`
// and the C compiler to make DIR/<stem>.so. The CREATE FUNCTION statements
// are in the file's ordinary SQL output (`--lib` names the library path).
//
// The entry points obey the rule of keal/docs/interop.md: no `longjmp`
// crosses a Keal frame. A Keal panic is caught in Keal (`try`), the entry
// point reads the message after every Keal frame has returned, and only
// then calls `ereport`. The other direction is the same rule: a query runs
// in a subtransaction under PG_TRY, and an error becomes a message the
// wrapper `throw`s — a Keal exception, catchable by the stored function or
// raised by the entry point at the end. Values cross as `KealStr*`,
// `int64_t`, `double` and `bool`; cells cross as text and are parsed on
// the Keal side.

import "./ast.keal"
import "./schema.keal"
import "./compile.keal"

func cType(t: TypeN): String {
    return when (t.name) {
        "Int" -> "int64_t"
        "Float" -> "double"
        "Bool" -> "bool"
        else -> "KealStr*"
    }
}

/// The value a guarded function answers when the real one panicked; the
/// entry point raises the error before anyone reads it.
func zeroOf(t: TypeN): String {
    return when (t.name) {
        "Int" -> "0"
        "Float" -> "0.0"
        "Bool" -> "false"
        else -> "\"\""
    }
}

/// The Keal type a query's value has. Dates, times, uuids, enums and bytes
/// are their SQL text.
package func kealType(ty: Ty): String {
    val base = when (ty.name) {
        "Int", "BigInt" -> "Int"
        "Float" -> "Float"
        "Bool", "Bool3" -> "Bool"
        else -> if (ty.name.startsWith("row:")) { ty.name.drop(4) } else { "String" }
    }
    return if (ty.optional) { base + "?" } else { base }
}

/// The expression that reads cell `col` of row `i` as a Keal value.
func cellExpr(ty: Ty, col: Int): String { cellExprOn("spi", ty, col) }

/// The same, on a named bridge: `spi` inside PostgreSQL, `kc` in a client.
package func cellExprOn(b: String, ty: Ty, col: Int): String {
    val get = when (ty.name) {
        "Int", "BigInt" -> "${b}Int(i, ${col})"
        "Float" -> "${b}Float(i, ${col})"
        "Bool", "Bool3" -> "${b}Bool(i, ${col})"
        else -> "${b}Str(i, ${col})"
    }
    if (ty.optional) { return "if (${b}IsNull(i, ${col})) { null } else { ${get} }" }
    return get
}

func cEscape(s: String): String {
    var out = ""
    for (c in s) {
        out += when (c) {
            "\\" -> "\\\\"
            "\"" -> "\\\""
            "\n" -> "\\n"
            else -> c
        }
    }
    return out
}

package func plkealSource(compiler: Compiler): String {
    val program = compiler.program
    val schema = compiler.schema
    val queries = compiler.queries
    var out = "// Generated by `kealsql --plkeal` from ${compiler.file}. Do not edit; edit the .kealsql.\n\n"
    out += "native \"\"\"\n#include \"postgres.h\"\n#include \"fmgr.h\"\n#include \"utils/builtins.h\"\n#include \"varatt.h\"\nPG_MODULE_MAGIC;\n\"\"\"\n\n"

    // ---- rows as records: one per table a query answers whole, and one per
    // query that selects several columns, named after it (`postsRow` for
    // `posts`), its fields named after the columns. Never a tuple: a tuple
    // holds five at most, and a name beats a position.
    val triggers = program.triggers
    val setofs = program.stored.filter({ compiler.storedSetof(it) })
    val hasSpi = not queries.isEmpty() or not triggers.isEmpty() or not setofs.isEmpty()
    val hasOut = not triggers.isEmpty() or not setofs.isEmpty()
    val rowTables: List<String> = []
    for (q in queries) { if (q.rowTable != "" and not rowTables.contains(q.rowTable)) { rowTables.add(q.rowTable) } }
    for (tr in triggers) { unless (rowTables.contains(tr.table)) { rowTables.add(tr.table) } }
    for (s in setofs) {
        val elem = compiler.storedElem(s)
        if (schema.tables.containsKey(elem.name) and not rowTables.contains(elem.name)) { rowTables.add(elem.name) }
    }
    for (name in rowTables) {
        val t = schema.tables[name]!!
        out += recordDecl(name, t.columns.map({ it.name }), t.columns.map({ kealType(it.ty()) }))
    }
    for (q in queries) {
        if (q.rowTable == "" and q.colTys.size > 1) {
            out += recordDecl(rowRecord(q), q.colNames, q.colTys.map({ kealType(it) }))
        }
    }
    out += "\n"

    // ---- the stored functions, verbatim
    for (s in program.stored) {
        val params = s.params.map({ "${it.name}: ${it.ty.render()}" }).join(", ")
        out += "func ${s.name}(${params}): ${s.ret!!.render()} {${s.body}}\n\n"
    }

    // ---- the trigger bodies: `row` is the row being written, `old` the one it replaces
    for (tr in triggers) {
        val t = schema.tables[tr.table]!!
        val params = when (tr.event) {
            "insert" -> "row: ${t.name}"
            "update" -> "row: ${t.name}, old: ${t.name}"
            else -> "old: ${t.name}"
        }
        val answers = tr.timing == "before" and tr.event != "delete"
        if (answers) { out += "func trg_${tr.name}(${params}): ${t.name} {${tr.body}}\n\n" }
        else { out += "proc trg_${tr.name}(${params}) {${tr.body}}\n\n" }
    }

    if (hasOut) {
        out += "extern proc outCell(s: borrow String) = \"plkeal_out\"\n"
        out += "extern proc outNull() = \"plkeal_out_null\"\n\n"
    }

    // ---- the trigger bridge, as seen from Keal
    if (not triggers.isEmpty()) {
        out += "extern func trgHas(which: Int): Bool = \"plkeal_trg_has\"\n"
        out += "extern func trgIsNull(which: Int, col: Int): Bool = \"plkeal_trg_is_null\"\n"
        out += "extern func trgStr(which: Int, col: Int): own String = \"plkeal_trg_str\"\n"
        out += "extern func trgInt(which: Int, col: Int): Int = \"plkeal_trg_int\"\n"
        out += "extern func trgFloat(which: Int, col: Int): Float = \"plkeal_trg_float\"\n"
        out += "extern func trgBool(which: Int, col: Int): Bool = \"plkeal_trg_bool\"\n\n"
        val readers: List<String> = []
        for (tr in triggers) {
            unless (readers.contains(tr.table)) {
                readers.add(tr.table)
                val t = schema.tables[tr.table]!!
                out += "func plkealRead${t.name}(which: Int): ${t.name} {\n"
                var c = 0
                val names: List<String> = []
                for (col in t.columns) {
                    out += "    val c${c}: ${kealType(col.ty())} = ${cellExpr(col.ty(), c).replace("spi", "trg").replace("(i, ", "(which, ")}\n"
                    names.add("c${c}")
                    c += 1
                }
                out += "    return ${t.name}(${names.join(", ")})\n}\n\n"
            }
        }
    }

    // ---- the SPI bridge, as seen from Keal
    if (not queries.isEmpty()) {
        out += "extern proc spiArgString(s: borrow String) = \"plkeal_spi_arg\"\n"
        out += "extern proc spiArgNull() = \"plkeal_spi_arg_null\"\n"
        out += "extern proc spiRun(slot: Int) = \"plkeal_spi_run\"\n"
        out += "extern func spiFailed(): Bool = \"plkeal_spi_failed\"\n"
        out += "extern func spiMessage(): own String = \"plkeal_spi_message\"\n"
        out += "extern func spiRows(): Int = \"plkeal_spi_rows\"\n"
        out += "extern func spiIsNull(row: Int, col: Int): Bool = \"plkeal_spi_is_null\"\n"
        out += "extern func spiStr(row: Int, col: Int): own String = \"plkeal_spi_str\"\n"
        out += "extern func spiInt(row: Int, col: Int): Int = \"plkeal_spi_int\"\n"
        out += "extern func spiFloat(row: Int, col: Int): Float = \"plkeal_spi_float\"\n"
        out += "extern func spiBool(row: Int, col: Int): Bool = \"plkeal_spi_bool\"\n\n"
        out += "/// A query that failed is a Keal exception: catch it, or let the entry point raise it.\n"
        out += "extern proc spiExec(sql: borrow String) = \"plkeal_spi_exec\"\n"
        out += "proc spiCheck(what: String) { if (spiFailed()) { throw what + \": \" + spiMessage() } }\n\n"
        var slot = 0
        for (q in queries) {
            out += queryWrapper(q, slot, schema)
            slot += 1
        }
    }

    // ---- the guards
    // `null` at rest: the program's `main` never runs inside PostgreSQL, so a
    // global must be right as C leaves it — zeroed. A `String` global would
    // be a null pointer read as a string.
    out += "var plkealError: String? = null\n"
    out += "func plkealFailed(): Bool { plkealError != null }\n"
    out += "func plkealMessage(): String { plkealError ?: \"\" }\n\n"
    for (s in program.stored) {
        val params = s.params.map({ "${it.name}: ${it.ty.render()}" }).join(", ")
        val args = s.params.map({ it.name }).join(", ")
        if (compiler.storedSetof(s)) {
            // Many results: pushed as cells, the count answered.
            val elem = compiler.storedElem(s)
            val table = schema.tables[elem.name]
            out += "func plkeal_${s.name}(${params}): Int {\n"
            out += "    plkealError = null\n"
            out += "    try {\n"
            out += "        val xs = ${s.name}(${args})\n"
            out += "        for (x in xs) {\n"
            if (table == null) {
                out += "            outCell(\"\" + x)\n"
            } else {
                for (col in table.columns) {
                    if (col.optional) {
                        out += "            val v_${col.name} = x.${col.name}\n"
                        out += "            if (v_${col.name} == null) { outNull() } else { outCell(\"\" + v_${col.name}) }\n"
                    } else {
                        out += "            outCell(\"\" + x.${col.name})\n"
                    }
                }
            }
            out += "        }\n"
            out += "        return xs.size\n"
            out += "    } catch (e) { plkealError = e; return 0 }\n"
            out += "}\n\n"
            continue
        }
        out += "func plkeal_${s.name}(${params}): ${s.ret!!.render()} {\n"
        out += "    plkealError = null\n"
        out += "    try { return ${s.name}(${args}) } catch (e) { plkealError = e; return ${zeroOf(s.ret!!)} }\n"
        out += "}\n\n"
    }

    for (tr in triggers) {
        val t = schema.tables[tr.table]!!
        val answers = tr.timing == "before" and tr.event != "delete"
        out += "func plkeal_trg_${tr.name}(): Bool {\n"
        out += "    plkealError = null\n"
        out += "    try {\n"
        if (tr.event != "delete") { out += "        val row = plkealRead${t.name}(0)\n" }
        if (tr.event != "insert") { out += "        val old = plkealRead${t.name}(1)\n" }
        val args = when (tr.event) {
            "insert" -> "row"
            "update" -> "row, old"
            else -> "old"
        }
        if (answers) {
            out += "        val out = trg_${tr.name}(${args})\n"
            for (col in t.columns) {
                if (col.optional) {
                    out += "        val v_${col.name} = out.${col.name}\n"
                    out += "        if (v_${col.name} == null) { outNull() } else { outCell(\"\" + v_${col.name}) }\n"
                } else {
                    out += "        outCell(\"\" + out.${col.name})\n"
                }
            }
            out += "        return true\n"
        } else {
            out += "        trg_${tr.name}(${args})\n"
            out += "        return false\n"
        }
        out += "    } catch (e) { plkealError = e; return false }\n"
        out += "}\n\n"
    }

    // ---- the C side
    out += "native \"\"\"\n"
    out += "/* What the program's main does: the runtime, then the program's own top\n"
    out += " * level — which is what sets its globals. Once per backend, when PostgreSQL\n"
    out += " * loads the library. Both are promised by `keal emit-header`. */\n"
    out += "void _PG_init(void) { keal_runtime_init(); keal_program_run(); }\n\n"
    if (hasSpi) { out += spiBridge(queries) }
    if (hasOut) { out += outBridge() }
    if (not triggers.isEmpty()) { out += triggerBridge() }
    out += "/* Raises the panic the guard caught, once every Keal frame has returned. */\n"
    out += "static void plkeal_raise(void) {\n"
    out += "    KealStr* m = k_plkealMessage();\n"
    out += "    char* msg = pnstrdup(keal_abi_str_bytes(m), (Size)keal_abi_str_len(m));\n"
    out += "    keal_abi_str_release(m);\n"
    out += "    ereport(ERROR, (errcode(ERRCODE_EXTERNAL_ROUTINE_EXCEPTION), errmsg(\"%s\", msg)));\n"
    out += "}\n\n"
    for (s in program.stored) {
        val entry = "kealsql_${snakeName(s.name)}"
        out += "PG_FUNCTION_INFO_V1(${entry});\n"
        out += "Datum ${entry}(PG_FUNCTION_ARGS) {\n"
        var i = 0
        val args: List<String> = []
        val releases: List<String> = []
        val setof = compiler.storedSetof(s)
        if (setof) {
            // Value-per-call: the first call runs the Keal function and keeps its
            // cells in the multi-call context; every call hands one result back.
            val elem = compiler.storedElem(s)
            val table = schema.tables[elem.name]
            val ncols = if (table == null) { 1 } else { table.columns.size }
            out += "    FuncCallContext* fc;\n"
            out += "    if (SRF_IS_FIRSTCALL()) {\n"
            out += "        fc = SRF_FIRSTCALL_INIT();\n"
            out += "        MemoryContext oldctx = MemoryContextSwitchTo(fc->multi_call_memory_ctx);\n"
            i = 0
            for (p in s.params) {
                when (p.ty.name) {
                    "Int" -> { out += "        int64_t a${i} = PG_GETARG_INT64(${i});\n" }
                    "Float" -> { out += "        double a${i} = PG_GETARG_FLOAT8(${i});\n" }
                    "Bool" -> { out += "        bool a${i} = PG_GETARG_BOOL(${i});\n" }
                    else -> {
                        out += "        text* t${i} = PG_GETARG_TEXT_PP(${i});\n"
                        out += "        KealStr* a${i} = keal_abi_str_new(VARDATA_ANY(t${i}), VARSIZE_ANY_EXHDR(t${i}));\n"
                        releases.add("        keal_abi_str_release(a${i});\n")
                    }
                }
                args.add("a${i}")
                i += 1
            }
            out += "        if (SPI_connect() != SPI_OK_CONNECT) { elog(ERROR, \"SPI_connect failed\"); }\n"
            out += "        plkeal_out_reset();\n"
            out += "        int64_t n = k_plkeal_${s.name}(${args.join(", ")});\n"
            for (r in releases) { out += r }
            out += "        plkeal_spi_reset();\n"
            out += "        SPI_finish();\n"
            out += "        if (k_plkealFailed()) { plkeal_raise(); }\n"
            out += "        fc->max_calls = (uint64)n;\n"
            out += "        fc->user_fctx = plkeal_out_keep(${ncols});\n"
            if (table != null) {
                out += "        TupleDesc td = RelationNameGetTupleDesc(\"${qualName(schema, table.name).replace("\"", "")}\");\n"
                out += "        fc->tuple_desc = BlessTupleDesc(td);\n"
                out += "        fc->attinmeta = TupleDescGetAttInMetadata(td);\n"
            }
            out += "        MemoryContextSwitchTo(oldctx);\n"
            out += "    }\n"
            out += "    fc = SRF_PERCALL_SETUP();\n"
            out += "    if (fc->call_cntr >= fc->max_calls) { SRF_RETURN_DONE(fc); }\n"
            out += "    char** cells = ((char**) fc->user_fctx) + fc->call_cntr * ${ncols};\n"
            if (table != null) {
                out += "    HeapTuple tuple = BuildTupleFromCStrings(fc->attinmeta, cells);\n"
                out += "    SRF_RETURN_NEXT(fc, HeapTupleGetDatum(tuple));\n"
            } else {
                when (elem.name) {
                    "Int" -> { out += "    SRF_RETURN_NEXT(fc, Int64GetDatum(strtoll(cells[0], NULL, 10)));\n" }
                    "Float" -> { out += "    SRF_RETURN_NEXT(fc, Float8GetDatum(strtod(cells[0], NULL)));\n" }
                    "Bool" -> { out += "    SRF_RETURN_NEXT(fc, BoolGetDatum(cells[0][0] == 't'));\n" }
                    else -> { out += "    SRF_RETURN_NEXT(fc, PointerGetDatum(cstring_to_text(cells[0])));\n" }
                }
            }
            out += "}\n\n"
            continue
        }
        for (p in s.params) {
            when (p.ty.name) {
                "Int" -> { out += "    int64_t a${i} = PG_GETARG_INT64(${i});\n" }
                "Float" -> { out += "    double a${i} = PG_GETARG_FLOAT8(${i});\n" }
                "Bool" -> { out += "    bool a${i} = PG_GETARG_BOOL(${i});\n" }
                else -> {
                    out += "    text* t${i} = PG_GETARG_TEXT_PP(${i});\n"
                    out += "    KealStr* a${i} = keal_abi_str_new(VARDATA_ANY(t${i}), VARSIZE_ANY_EXHDR(t${i}));\n"
                    releases.add("    keal_abi_str_release(a${i});\n")
                }
            }
            args.add("a${i}")
            i += 1
        }
        if (hasSpi) {
            out += "    if (SPI_connect() != SPI_OK_CONNECT) { elog(ERROR, \"SPI_connect failed\"); }\n"
        }
        out += "    ${cType(s.ret!!)} r = k_plkeal_${s.name}(${args.join(", ")});\n"
        for (r in releases) { out += r }
        if (hasSpi) {
            out += "    plkeal_spi_reset();\n"
            out += "    SPI_finish();\n"
        }
        out += "    if (k_plkealFailed()) {\n"
        if (s.ret!!.name == "String") { out += "        keal_abi_str_release(r);\n" }
        out += "        plkeal_raise();\n"
        out += "    }\n"
        when (s.ret!!.name) {
            "Int" -> { out += "    PG_RETURN_INT64(r);\n" }
            "Float" -> { out += "    PG_RETURN_FLOAT8(r);\n" }
            "Bool" -> { out += "    PG_RETURN_BOOL(r);\n" }
            else -> {
                out += "    text* result = cstring_to_text_with_len(keal_abi_str_bytes(r), (int)keal_abi_str_len(r));\n"
                out += "    keal_abi_str_release(r);\n"
                out += "    PG_RETURN_TEXT_P(result);\n"
            }
        }
        out += "}\n\n"
    }
    for (tr in triggers) {
        val entry = "kealsql_trg_${snakeName(tr.name)}"
        out += "PG_FUNCTION_INFO_V1(${entry});\n"
        out += "Datum ${entry}(PG_FUNCTION_ARGS) {\n"
        out += "    if (!CALLED_AS_TRIGGER(fcinfo)) { elog(ERROR, \"${entry}: not called as a trigger\"); }\n"
        out += "    TriggerData* td = (TriggerData*) fcinfo->context;\n"
        out += "    TupleDesc desc = RelationGetDescr(td->tg_relation);\n"
        out += "    HeapTuple row = NULL;\n    HeapTuple old = NULL;\n"
        out += "    if (TRIGGER_FIRED_BY_INSERT(td->tg_event)) { row = td->tg_trigtuple; }\n"
        out += "    else if (TRIGGER_FIRED_BY_UPDATE(td->tg_event)) { row = td->tg_newtuple; old = td->tg_trigtuple; }\n"
        out += "    else { old = td->tg_trigtuple; }\n"
        out += "    if (SPI_connect() != SPI_OK_CONNECT) { elog(ERROR, \"SPI_connect failed\"); }\n"
        out += "    plkeal_trg_load(0, row, desc);\n    plkeal_trg_load(1, old, desc);\n    plkeal_out_reset();\n"
        out += "    bool produced = k_plkeal_trg_${tr.name}();\n"
        out += "    HeapTuple result = row ? row : old;\n"
        out += "    if (!k_plkealFailed() && produced) { result = SPI_copytuple(plkeal_trg_build(desc)); }\n"
        out += "    plkeal_spi_reset();\n    plkeal_trg_reset();\n    SPI_finish();\n"
        out += "    if (k_plkealFailed()) { plkeal_raise(); }\n"
        out += "    PG_RETURN_POINTER(result);\n"
        out += "}\n\n"
    }
    out += "\"\"\"\n\n"
    out += "proc main() {}\n"
    return out
}

/// The out cells: what a trigger or a set-returning function answers, as
/// text, one cell at a time.
func outBridge(): String {
    return """#include "funcapi.h"

#define PLKEAL_OUT_MAX 65536
static char** plkeal_out_cells;
static int plkeal_out_n;
static int plkeal_out_cap;

static void plkeal_out_reset(void) {
    for (int k = 0; k < plkeal_out_n; k++) { free(plkeal_out_cells[k]); }
    plkeal_out_n = 0;
}

static void plkeal_out_push(char* s) {
    if (plkeal_out_n >= plkeal_out_cap) {
        int cap = plkeal_out_cap ? plkeal_out_cap * 2 : 64;
        plkeal_out_cells = realloc(plkeal_out_cells, sizeof(char*) * (size_t)cap);
        plkeal_out_cap = cap;
    }
    plkeal_out_cells[plkeal_out_n++] = s;
}

void plkeal_out(const char* s) { plkeal_out_push(strdup(s)); }
void plkeal_out_null(void) { plkeal_out_push(NULL); }

/* The out cells copied into the current memory context, `ncols` per row;
 * the static buffer is free to be reused by a nested call. */
static char** plkeal_out_keep(int ncols) {
    int rows = ncols ? plkeal_out_n / ncols : 0;
    char** kept = palloc0(sizeof(char*) * (size_t)(rows * ncols + 1));
    for (int k = 0; k < rows * ncols; k++) { kept[k] = plkeal_out_cells[k] ? pstrdup(plkeal_out_cells[k]) : NULL; }
    plkeal_out_reset();
    return kept;
}

"""
}

/// The C half of the trigger bridge: the row and the old row as text cells,
/// and the row a `before` trigger answers, built back from text through
/// each column's input function.
func triggerBridge(): String {
    return """#include "commands/trigger.h"
#include "funcapi.h"
#include "access/htup_details.h"

#define PLKEAL_TRG_MAXCOLS 256
static char* plkeal_trg_cells[2][PLKEAL_TRG_MAXCOLS];
static int plkeal_trg_n[2];
static bool plkeal_trg_present[2];

static void plkeal_trg_load(int which, HeapTuple t, TupleDesc d) {
    for (int k = 0; k < plkeal_trg_n[which]; k++) { free(plkeal_trg_cells[which][k]); plkeal_trg_cells[which][k] = NULL; }
    plkeal_trg_n[which] = 0;
    plkeal_trg_present[which] = (t != NULL);
    if (t == NULL) { return; }
    int k = 0;
    for (int i = 0; i < d->natts && k < PLKEAL_TRG_MAXCOLS; i++) {
        if (TupleDescAttr(d, i)->attisdropped) { continue; }
        char* v = SPI_getvalue(t, d, i + 1);
        plkeal_trg_cells[which][k++] = v ? strdup(v) : NULL;
        if (v) { pfree(v); }
    }
    plkeal_trg_n[which] = k;
}

static void plkeal_trg_reset(void) {
    plkeal_trg_load(0, NULL, NULL);
    plkeal_trg_load(1, NULL, NULL);
    plkeal_out_reset();
}

/* The answered row as a tuple: dropped attributes stay null. */
static HeapTuple plkeal_trg_build(TupleDesc d) {
    char** vals = palloc0(sizeof(char*) * d->natts);
    int k = 0;
    for (int i = 0; i < d->natts; i++) {
        if (TupleDescAttr(d, i)->attisdropped) { continue; }
        vals[i] = k < plkeal_out_n ? plkeal_out_cells[k] : NULL;
        k++;
    }
    return BuildTupleFromCStrings(TupleDescGetAttInMetadata(d), vals);
}

bool plkeal_trg_has(int64_t which) { return which >= 0 && which < 2 && plkeal_trg_present[which]; }
static const char* plkeal_trg_cell(int64_t which, int64_t col) {
    if (which < 0 || which >= 2 || col < 0 || col >= plkeal_trg_n[which]) { return NULL; }
    return plkeal_trg_cells[which][col];
}
bool plkeal_trg_is_null(int64_t which, int64_t col) { return plkeal_trg_cell(which, col) == NULL; }
char* plkeal_trg_str(int64_t which, int64_t col) { const char* c = plkeal_trg_cell(which, col); return strdup(c ? c : ""); }
int64_t plkeal_trg_int(int64_t which, int64_t col) { const char* c = plkeal_trg_cell(which, col); return c ? strtoll(c, NULL, 10) : 0; }
double plkeal_trg_float(int64_t which, int64_t col) { const char* c = plkeal_trg_cell(which, col); return c ? strtod(c, NULL) : 0.0; }
bool plkeal_trg_bool(int64_t which, int64_t col) { const char* c = plkeal_trg_cell(which, col); return c && c[0] == 't'; }

"""
}

/// `PostsRow` for the query `posts`.
func rowRecord(q: QueryInfo): String { q.name.take(1).toUpper() + q.name.drop(1) + "Row" }

/// A row as a record. Keal's own toString serves (since keal 9709d1b, which
/// fixed it for optional value fields).
func recordDecl(name: String, fields: List<String>, types: List<String>): String {
    val decl: List<String> = []
    var i = 0
    while (i < fields.size) {
        decl.add("val ${fields[i]}: ${types[i]}")
        i += 1
    }
    return "record ${name}(${decl.join(", ")})\n"
}

/// The Keal function a stored function calls to run one of the file's queries.
func queryWrapper(q: QueryInfo, slot: Int, schema: Schema): String { queryWrapperOn("spi", "", q, slot, schema) }

/// `b` names the bridge; `handle` is the connection expression a client
/// passes to it ("" inside PostgreSQL, where there is one connection).
package func queryWrapperOn(b: String, handle: String, q: QueryInfo, slot: Int, schema: Schema): String {
    val params = q.params.map({ "${it.name}: ${kealType(it.ty)}" }).join(", ")
    val run = if (handle == "") { "${b}Run(${slot})" } else { "${b}Run(${handle}, ${slot})" }
    val one = when (q.kind) {
        "count" -> "Int"
        "exists" -> "Bool"
        "row" -> q.rowTable
        "none" -> ""
        else -> {
            if (q.rowTable != "") { q.rowTable }
            else if (q.colTys.size == 1) { kealType(q.colTys[0]) }
            else { rowRecord(q) }
        }
    }
    val ret = when (q.kind) {
        "list" -> "List<${one}>"
        "first" -> if (one.endsWith("?")) { one } else { one + "?" }
        else -> one
    }
    var out = if (q.kind == "none") { "proc ${q.name}(${params}) {\n" } else { "func ${q.name}(${params}): ${ret} {\n" }
    if (q.utility) {
        // A statement PREPARE refuses: run as it is.
        out += "    ${b}Exec(${if (handle == "") { "" } else { handle + ", " }}\"${q.sql.replace("\"", "\\\"")}\")\n"
        out += "    ${b}Check(\"${q.name}\")\n}\n\n"
        return out
    }
    for (p in q.params) {
        if (p.ty.optional) {
            out += "    if (${p.name} == null) { ${b}ArgNull() } else { ${b}ArgString(\"\" + ${p.name}) }\n"
        } else {
            out += "    ${b}ArgString(\"\" + ${p.name})\n"
        }
    }
    out += "    ${run}\n"
    out += "    ${b}Check(\"${q.name}\")\n"
    // how one row is read
    var build = ""
    var decl = ""
    if (q.rowTable != "") {
        val t = schema.tables[q.rowTable]!!
        var c = 0
        val names: List<String> = []
        for (col in t.columns) {
            decl += "        val c${c}: ${kealType(col.ty())} = ${cellExprOn(b, col.ty(), c)}\n"
            names.add("c${c}")
            c += 1
        }
        build = "${q.rowTable}(${names.join(", ")})"
    } else if (q.kind == "count") {
        build = "${b}Int(i, 0)"
    } else if (q.kind == "exists") {
        build = "${b}Bool(i, 0)"
    } else if (q.kind != "none") {
        var c = 0
        val names: List<String> = []
        for (ty in q.colTys) {
            decl += "        val c${c}: ${kealType(ty)} = ${cellExprOn(b, ty, c)}\n"
            names.add("c${c}")
            c += 1
        }
        build = if (names.size == 1) { names[0] } else { "${rowRecord(q)}(${names.join(", ")})" }
    }
    when (q.kind) {
        "none" -> {}
        "list" -> {
            out += "    val out: List<${one}> = []\n"
            out += "    var i = 0\n"
            out += "    while (i < ${b}Rows()) {\n"
            out += decl
            out += "        out.add(${build})\n"
            out += "        i += 1\n"
            out += "    }\n"
            out += "    return out\n"
        }
        "first" -> {
            out += "    if (${b}Rows() == 0) { return null }\n"
            out += "    val i = 0\n"
            out += decl
            out += "    return ${build}\n"
        }
        else -> {
            // single, row, count, exists: exactly one row
            out += "    if (${b}Rows() != 1) { throw \"${q.name}: expected one row, got \" + ${b}Rows() }\n"
            out += "    val i = 0\n"
            out += decl
            out += "    return ${build}\n"
        }
    }
    out += "}\n\n"
    return out
}

/// The C half of the bridge: one plan per query, prepared on first use and
/// kept; arguments gathered as text and converted by each type's input
/// function; every run in a subtransaction under PG_TRY, so an error is
/// rolled back and handed to Keal as a message rather than thrown through it.
func spiBridge(queries: List<QueryInfo>): String {
    var out = "#include \"executor/spi.h\"\n#include \"access/xact.h\"\n#include \"utils/memutils.h\"\n#include \"utils/lsyscache.h\"\n#include \"utils/resowner.h\"\n\n"
    out += "#define PLKEAL_NQ ${queries.size.max(1)}\n"
    out += "#define PLKEAL_MAXARGS 32\n"
    out += "static const char* plkeal_sql[PLKEAL_NQ] = {\n"
    for (q in queries) { out += "    \"${cEscape(q.sql)}\",\n" }
    out += "};\n"
    out += "static const int plkeal_nargs[PLKEAL_NQ] = { ${queries.map({ "" + it.params.size }).join(", ")}${if (queries.isEmpty()) { "0" } else { "" }} };\n"
    out += "static const char* plkeal_argtypes[PLKEAL_NQ][PLKEAL_MAXARGS] = {\n"
    for (q in queries) { out += "    { ${q.params.map({ "\"" + it.sqlType + "\"" }).join(", ")} },\n" }
    out += "};\n"
    out += """static SPIPlanPtr plkeal_plans[PLKEAL_NQ];
static Oid plkeal_argoids[PLKEAL_NQ][PLKEAL_MAXARGS];

static char* plkeal_args[PLKEAL_MAXARGS];
static bool plkeal_arg_null[PLKEAL_MAXARGS];
static int plkeal_argc;
static char** plkeal_cells;
static bool* plkeal_nulls;
static int64_t plkeal_nrows;
static int64_t plkeal_ncols;
static char* plkeal_err;

static void plkeal_free_result(void) {
    if (plkeal_cells) {
        for (int64_t k = 0; k < plkeal_nrows * plkeal_ncols; k++) { free(plkeal_cells[k]); }
        free(plkeal_cells); free(plkeal_nulls);
    }
    plkeal_cells = NULL; plkeal_nulls = NULL; plkeal_nrows = 0; plkeal_ncols = 0;
}

static void plkeal_reset_args(void) {
    for (int k = 0; k < plkeal_argc; k++) { free(plkeal_args[k]); plkeal_args[k] = NULL; }
    plkeal_argc = 0;
}

/* Between two calls of a stored function nothing of the last result may survive. */
static void plkeal_spi_reset(void) {
    plkeal_free_result();
    plkeal_reset_args();
    free(plkeal_err); plkeal_err = NULL;
}

void plkeal_spi_arg(const char* s) {
    if (plkeal_argc < PLKEAL_MAXARGS) { plkeal_args[plkeal_argc] = strdup(s); plkeal_arg_null[plkeal_argc] = false; }
    plkeal_argc++;
}

void plkeal_spi_arg_null(void) {
    if (plkeal_argc < PLKEAL_MAXARGS) { plkeal_args[plkeal_argc] = NULL; plkeal_arg_null[plkeal_argc] = true; }
    plkeal_argc++;
}

bool plkeal_spi_failed(void) { return plkeal_err != NULL; }
char* plkeal_spi_message(void) { return strdup(plkeal_err ? plkeal_err : ""); }
int64_t plkeal_spi_rows(void) { return plkeal_nrows; }

static const char* plkeal_cell(int64_t row, int64_t col) {
    if (row < 0 || row >= plkeal_nrows || col < 0 || col >= plkeal_ncols) { return NULL; }
    return plkeal_cells[row * plkeal_ncols + col];
}
bool plkeal_spi_is_null(int64_t row, int64_t col) { return plkeal_cell(row, col) == NULL; }
char* plkeal_spi_str(int64_t row, int64_t col) { const char* c = plkeal_cell(row, col); return strdup(c ? c : ""); }
int64_t plkeal_spi_int(int64_t row, int64_t col) { const char* c = plkeal_cell(row, col); return c ? strtoll(c, NULL, 10) : 0; }
double plkeal_spi_float(int64_t row, int64_t col) { const char* c = plkeal_cell(row, col); return c ? strtod(c, NULL) : 0.0; }
bool plkeal_spi_bool(int64_t row, int64_t col) { const char* c = plkeal_cell(row, col); return c && c[0] == 't'; }

/* A statement as it is, outside the plans: REFRESH MATERIALIZED VIEW and the like. */
void plkeal_spi_exec(const char* sql) {
    plkeal_free_result();
    free(plkeal_err); plkeal_err = NULL;
    MemoryContext oldctx = CurrentMemoryContext;
    ResourceOwner oldowner = CurrentResourceOwner;
    BeginInternalSubTransaction(NULL);
    MemoryContextSwitchTo(oldctx);
    PG_TRY();
    {
        int rc = SPI_execute(sql, false, 0);
        if (rc < 0) { elog(ERROR, "SPI_execute: %s", SPI_result_code_string(rc)); }
        plkeal_nrows = (int64_t)SPI_processed; plkeal_ncols = 0;
        if (SPI_tuptable != NULL) { SPI_freetuptable(SPI_tuptable); }
        ReleaseCurrentSubTransaction();
        MemoryContextSwitchTo(oldctx);
        CurrentResourceOwner = oldowner;
    }
    PG_CATCH();
    {
        MemoryContextSwitchTo(oldctx);
        ErrorData* edata = CopyErrorData();
        FlushErrorState();
        RollbackAndReleaseCurrentSubTransaction();
        MemoryContextSwitchTo(oldctx);
        CurrentResourceOwner = oldowner;
        plkeal_err = strdup(edata->message ? edata->message : "error");
        FreeErrorData(edata);
    }
    PG_END_TRY();
}

void plkeal_spi_run(int64_t slot) {
    plkeal_free_result();
    free(plkeal_err); plkeal_err = NULL;
    if (slot < 0 || slot >= PLKEAL_NQ) { plkeal_err = strdup("no such query"); plkeal_reset_args(); return; }
    int n = plkeal_nargs[slot];
    if (plkeal_argc != n) { plkeal_err = strdup("wrong number of arguments"); plkeal_reset_args(); return; }
    MemoryContext oldctx = CurrentMemoryContext;
    ResourceOwner oldowner = CurrentResourceOwner;
    BeginInternalSubTransaction(NULL);
    MemoryContextSwitchTo(oldctx);
    PG_TRY();
    {
        if (plkeal_plans[slot] == NULL) {
            for (int k = 0; k < n; k++) {
                plkeal_argoids[slot][k] = DatumGetObjectId(DirectFunctionCall1(regtypein, CStringGetDatum(plkeal_argtypes[slot][k])));
            }
            SPIPlanPtr p = SPI_prepare(plkeal_sql[slot], n, plkeal_argoids[slot]);
            if (p == NULL) { elog(ERROR, "SPI_prepare: %s", SPI_result_code_string(SPI_result)); }
            SPI_keepplan(p);
            plkeal_plans[slot] = p;
        }
        Datum values[PLKEAL_MAXARGS];
        char nulls[PLKEAL_MAXARGS];
        for (int k = 0; k < n; k++) {
            if (plkeal_arg_null[k]) { values[k] = (Datum)0; nulls[k] = 'n'; continue; }
            Oid infunc, ioparam;
            getTypeInputInfo(plkeal_argoids[slot][k], &infunc, &ioparam);
            values[k] = OidInputFunctionCall(infunc, plkeal_args[k], ioparam, -1);
            nulls[k] = ' ';
        }
        int rc = SPI_execute_plan(plkeal_plans[slot], values, nulls, false, 0);
        if (rc < 0) { elog(ERROR, "SPI_execute_plan: %s", SPI_result_code_string(rc)); }
        if (SPI_tuptable != NULL) {
            int64_t nr = (int64_t)SPI_processed;
            int64_t nc = SPI_tuptable->tupdesc->natts;
            plkeal_cells = calloc((size_t)(nr * nc + 1), sizeof(char*));
            plkeal_nulls = calloc((size_t)(nr * nc + 1), sizeof(bool));
            for (int64_t r = 0; r < nr; r++) {
                for (int64_t c = 0; c < nc; c++) {
                    char* v = SPI_getvalue(SPI_tuptable->vals[r], SPI_tuptable->tupdesc, (int)c + 1);
                    plkeal_cells[r * nc + c] = v ? strdup(v) : NULL;
                    if (v) { pfree(v); }
                }
            }
            plkeal_nrows = nr; plkeal_ncols = nc;
            SPI_freetuptable(SPI_tuptable);
        } else {
            plkeal_nrows = (int64_t)SPI_processed; plkeal_ncols = 0;
        }
        ReleaseCurrentSubTransaction();
        MemoryContextSwitchTo(oldctx);
        CurrentResourceOwner = oldowner;
    }
    PG_CATCH();
    {
        MemoryContextSwitchTo(oldctx);
        ErrorData* edata = CopyErrorData();
        FlushErrorState();
        RollbackAndReleaseCurrentSubTransaction();
        MemoryContextSwitchTo(oldctx);
        CurrentResourceOwner = oldowner;
        plkeal_free_result();
        plkeal_err = strdup(edata->message ? edata->message : "error");
        FreeErrorData(edata);
    }
    PG_END_TRY();
    plkeal_reset_args();
}

"""
    return out
}

package func plkealBuildScript(stem: String): String {
    var s = "#!/usr/bin/env sh\n"
    s += "# Builds ${stem}.so from ${stem}.keal: Keal to C, then the C compiler against\n"
    s += "# PostgreSQL's server headers. KEAL names the toolchain; pg_config must be on the path.\n"
    s += "set -e\n"
    s += "cd \"$(dirname \"$0\")\"\n"
    s += "KEAL=\"$" + "{KEAL:-keal}\"\n"
    s += "\"$" + "KEAL\" emit-c ${stem}.keal > ${stem}.c\n"
    s += "$" + "{CC:-cc} -shared -fPIC -O2 -std=gnu11 -D_GNU_SOURCE -I\"$(pg_config --includedir-server)\" -o ${stem}.so ${stem}.c\n"
    s += "echo \"${stem}.so\"\n"
    return s
}

/// Writes DIR/<stem>.keal and DIR/build.sh; answers what it wrote.
package func writePlkeal(compiler: Compiler, dir: String): List<String> {
    if (compiler.program.stored.isEmpty() and compiler.program.triggers.isEmpty()) {
        println("error: ${compiler.file} declares no stored function and no trigger")
        exit(1)
    }
    unless (makeDir(dir)) {
        println("error: cannot create `${dir}`")
        exit(1)
    }
    val stem = compiler.libStem()
    val keal = "${dir}/${stem}.keal"
    val build = "${dir}/build.sh"
    unless (writeFile(keal, plkealSource(compiler)) and writeFile(build, plkealBuildScript(stem))) {
        println("error: cannot write into `${dir}`")
        exit(1)
    }
    runCommand(["chmod", "+x", build])
    return [keal, build]
}
