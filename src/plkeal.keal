// plkeal: the stored functions of a file as a PostgreSQL shared library.
//
// `kealsql --plkeal DIR file.kealsql` writes DIR/<stem>.keal — a Keal
// program holding the stored functions verbatim, a guard around each that
// turns a panic into a message, a typed Keal wrapper for every query of
// the file (so a stored function calls `byAuthor(name)` and gets a
// `List<(Int, String)>`), and a `native` block with the PostgreSQL entry
// points and the SPI bridge — plus DIR/build.sh, which runs `keal emit-c`
// and the C compiler to make DIR/<stem>.so. The CREATE FUNCTION statements
// are in the file's ordinary SQL output (`--lib` names the library path).
//
// The entry points obey the rule of keal/docs/interop.md: no `longjmp`
// crosses a Keal frame. A Keal panic is caught in Keal (`try`), the entry
// point reads the message after every Keal frame has returned, and only
// then calls `ereport`. The other direction is the same rule: a query runs
// in a subtransaction under PG_TRY, and an error becomes a message the
// wrapper `throw`s — a Keal exception, catchable by the stored function or
// raised by the entry point at the end. Values cross as `KealStr*`,
// `int64_t`, `double` and `bool`; cells cross as text and are parsed on
// the Keal side.

import "./ast.keal"
import "./schema.keal"
import "./compile.keal"

func cType(t: TypeN): String {
    return when (t.name) {
        "Int" -> "int64_t"
        "Float" -> "double"
        "Bool" -> "bool"
        else -> "KealStr*"
    }
}

/// The value a guarded function answers when the real one panicked; the
/// entry point raises the error before anyone reads it.
func zeroOf(t: TypeN): String {
    return when (t.name) {
        "Int" -> "0"
        "Float" -> "0.0"
        "Bool" -> "false"
        else -> "\"\""
    }
}

/// The Keal type a query's value has. Dates, times, uuids, enums and bytes
/// are their SQL text.
func kealType(ty: Ty): String {
    val base = when (ty.name) {
        "Int", "BigInt" -> "Int"
        "Float" -> "Float"
        "Bool", "Bool3" -> "Bool"
        else -> if (ty.name.startsWith("row:")) { ty.name.drop(4) } else { "String" }
    }
    return if (ty.optional) { base + "?" } else { base }
}

/// The expression that reads cell `col` of row `i` as a Keal value.
func cellExpr(ty: Ty, col: Int): String {
    val get = when (ty.name) {
        "Int", "BigInt" -> "spiInt(i, ${col})"
        "Float" -> "spiFloat(i, ${col})"
        "Bool", "Bool3" -> "spiBool(i, ${col})"
        else -> "spiStr(i, ${col})"
    }
    if (ty.optional) { return "if (spiIsNull(i, ${col})) { null } else { ${get} }" }
    return get
}

func cEscape(s: String): String {
    var out = ""
    for (c in s) {
        out += when (c) {
            "\\" -> "\\\\"
            "\"" -> "\\\""
            "\n" -> "\\n"
            else -> c
        }
    }
    return out
}

package func plkealSource(compiler: Compiler): String {
    val program = compiler.program
    val schema = compiler.schema
    val queries = compiler.queries
    var out = "// Generated by `kealsql --plkeal` from ${compiler.file}. Do not edit; edit the .kealsql.\n\n"
    out += "native \"\"\"\n#include \"postgres.h\"\n#include \"fmgr.h\"\n#include \"utils/builtins.h\"\n#include \"varatt.h\"\nPG_MODULE_MAGIC;\n\"\"\"\n\n"

    // ---- rows as records: one per table a query answers whole, and one per
    // query that selects several columns, named after it (`postsRow` for
    // `posts`), its fields named after the columns. Never a tuple: a tuple
    // holds five at most, and a name beats a position.
    val rowTables: List<String> = []
    for (q in queries) { if (q.rowTable != "" and not rowTables.contains(q.rowTable)) { rowTables.add(q.rowTable) } }
    for (name in rowTables) {
        val t = schema.tables[name]!!
        out += recordDecl(name, t.columns.map({ it.name }), t.columns.map({ kealType(it.ty()) }))
    }
    for (q in queries) {
        if (q.rowTable == "" and q.colTys.size > 1) {
            out += recordDecl(rowRecord(q), q.colNames, q.colTys.map({ kealType(it) }))
        }
    }
    out += "\n"

    // ---- the stored functions, verbatim
    for (s in program.stored) {
        val params = s.params.map({ "${it.name}: ${it.ty.render()}" }).join(", ")
        out += "func ${s.name}(${params}): ${s.ret!!.render()} {${s.body}}\n\n"
    }

    // ---- the SPI bridge, as seen from Keal
    if (not queries.isEmpty()) {
        out += "extern proc spiArgString(s: borrow String) = \"plkeal_spi_arg\"\n"
        out += "extern proc spiArgNull() = \"plkeal_spi_arg_null\"\n"
        out += "extern proc spiRun(slot: Int) = \"plkeal_spi_run\"\n"
        out += "extern func spiFailed(): Bool = \"plkeal_spi_failed\"\n"
        out += "extern func spiMessage(): own String = \"plkeal_spi_message\"\n"
        out += "extern func spiRows(): Int = \"plkeal_spi_rows\"\n"
        out += "extern func spiIsNull(row: Int, col: Int): Bool = \"plkeal_spi_is_null\"\n"
        out += "extern func spiStr(row: Int, col: Int): own String = \"plkeal_spi_str\"\n"
        out += "extern func spiInt(row: Int, col: Int): Int = \"plkeal_spi_int\"\n"
        out += "extern func spiFloat(row: Int, col: Int): Float = \"plkeal_spi_float\"\n"
        out += "extern func spiBool(row: Int, col: Int): Bool = \"plkeal_spi_bool\"\n\n"
        out += "/// A query that failed is a Keal exception: catch it, or let the entry point raise it.\n"
        out += "proc spiCheck(what: String) { if (spiFailed()) { throw what + \": \" + spiMessage() } }\n\n"
        var slot = 0
        for (q in queries) {
            out += queryWrapper(q, slot, schema)
            slot += 1
        }
    }

    // ---- the guards
    // `null` at rest: the program's `main` never runs inside PostgreSQL, so a
    // global must be right as C leaves it — zeroed. A `String` global would
    // be a null pointer read as a string.
    out += "var plkealError: String? = null\n"
    out += "func plkealFailed(): Bool { plkealError != null }\n"
    out += "func plkealMessage(): String { plkealError ?: \"\" }\n\n"
    for (s in program.stored) {
        val params = s.params.map({ "${it.name}: ${it.ty.render()}" }).join(", ")
        val args = s.params.map({ it.name }).join(", ")
        out += "func plkeal_${s.name}(${params}): ${s.ret!!.render()} {\n"
        out += "    plkealError = null\n"
        out += "    try { return ${s.name}(${args}) } catch (e) { plkealError = e; return ${zeroOf(s.ret!!)} }\n"
        out += "}\n\n"
    }

    // ---- the C side
    out += "native \"\"\"\n"
    out += "/* The Keal runtime, as the program's main would have set it up. Once per\n"
    out += " * backend, when PostgreSQL loads the library; idempotent on Keal's side. */\n"
    out += "void _PG_init(void) { keal_runtime_init(); }\n\n"
    if (not queries.isEmpty()) { out += spiBridge(queries) }
    out += "/* Raises the panic the guard caught, once every Keal frame has returned. */\n"
    out += "static void plkeal_raise(void) {\n"
    out += "    KealStr* m = k_plkealMessage();\n"
    out += "    char* msg = pnstrdup(m->bytes, (Size)m->len);\n"
    out += "    keal_str_release(m);\n"
    out += "    ereport(ERROR, (errcode(ERRCODE_EXTERNAL_ROUTINE_EXCEPTION), errmsg(\"%s\", msg)));\n"
    out += "}\n\n"
    for (s in program.stored) {
        val entry = "kealsql_${snakeName(s.name)}"
        out += "PG_FUNCTION_INFO_V1(${entry});\n"
        out += "Datum ${entry}(PG_FUNCTION_ARGS) {\n"
        var i = 0
        val args: List<String> = []
        val releases: List<String> = []
        for (p in s.params) {
            when (p.ty.name) {
                "Int" -> { out += "    int64_t a${i} = PG_GETARG_INT64(${i});\n" }
                "Float" -> { out += "    double a${i} = PG_GETARG_FLOAT8(${i});\n" }
                "Bool" -> { out += "    bool a${i} = PG_GETARG_BOOL(${i});\n" }
                else -> {
                    out += "    text* t${i} = PG_GETARG_TEXT_PP(${i});\n"
                    out += "    KealStr* a${i} = keal_str_from_bytes(VARDATA_ANY(t${i}), VARSIZE_ANY_EXHDR(t${i}));\n"
                    releases.add("    keal_str_release(a${i});\n")
                }
            }
            args.add("a${i}")
            i += 1
        }
        if (not queries.isEmpty()) {
            out += "    if (SPI_connect() != SPI_OK_CONNECT) { elog(ERROR, \"SPI_connect failed\"); }\n"
        }
        out += "    ${cType(s.ret!!)} r = k_plkeal_${s.name}(${args.join(", ")});\n"
        for (r in releases) { out += r }
        if (not queries.isEmpty()) {
            out += "    plkeal_spi_reset();\n"
            out += "    SPI_finish();\n"
        }
        out += "    if (k_plkealFailed()) {\n"
        if (s.ret!!.name == "String") { out += "        keal_str_release(r);\n" }
        out += "        plkeal_raise();\n"
        out += "    }\n"
        when (s.ret!!.name) {
            "Int" -> { out += "    PG_RETURN_INT64(r);\n" }
            "Float" -> { out += "    PG_RETURN_FLOAT8(r);\n" }
            "Bool" -> { out += "    PG_RETURN_BOOL(r);\n" }
            else -> {
                out += "    text* result = cstring_to_text_with_len(r->bytes, (int)r->len);\n"
                out += "    keal_str_release(r);\n"
                out += "    PG_RETURN_TEXT_P(result);\n"
            }
        }
        out += "}\n\n"
    }
    out += "\"\"\"\n\n"
    out += "proc main() {}\n"
    return out
}

/// `PostsRow` for the query `posts`.
func rowRecord(q: QueryInfo): String { q.name.take(1).toUpper() + q.name.drop(1) + "Row" }

/// A record with an explicit toString: the C backend mis-compiles the one it
/// would synthesise for a record with an `Int?`, `Float?` or `Bool?` field
/// (reported to Keal); a written one is emitted as written.
func recordDecl(name: String, fields: List<String>, types: List<String>): String {
    val decl: List<String> = []
    val shown: List<String> = []
    var i = 0
    while (i < fields.size) {
        decl.add("val ${fields[i]}: ${types[i]}")
        shown.add("${fields[i]}=$" + "{this.${fields[i]}}")
        i += 1
    }
    var out = "record ${name}(${decl.join(", ")}) {\n"
    out += "    func toString(): String { \"${name}(${shown.join(", ")})\" }\n"
    out += "}\n"
    return out
}

/// The Keal function a stored function calls to run one of the file's queries.
func queryWrapper(q: QueryInfo, slot: Int, schema: Schema): String {
    val params = q.params.map({ "${it.name}: ${kealType(it.ty)}" }).join(", ")
    val one = when (q.kind) {
        "count" -> "Int"
        "exists" -> "Bool"
        "row" -> q.rowTable
        "none" -> ""
        else -> {
            if (q.rowTable != "") { q.rowTable }
            else if (q.colTys.size == 1) { kealType(q.colTys[0]) }
            else { rowRecord(q) }
        }
    }
    val ret = when (q.kind) {
        "list" -> "List<${one}>"
        "first" -> if (one.endsWith("?")) { one } else { one + "?" }
        else -> one
    }
    var out = if (q.kind == "none") { "proc ${q.name}(${params}) {\n" } else { "func ${q.name}(${params}): ${ret} {\n" }
    for (p in q.params) {
        if (p.ty.optional) {
            out += "    if (${p.name} == null) { spiArgNull() } else { spiArgString(\"\" + ${p.name}) }\n"
        } else {
            out += "    spiArgString(\"\" + ${p.name})\n"
        }
    }
    out += "    spiRun(${slot})\n"
    out += "    spiCheck(\"${q.name}\")\n"
    // how one row is read
    var build = ""
    var decl = ""
    if (q.rowTable != "") {
        val t = schema.tables[q.rowTable]!!
        var c = 0
        val names: List<String> = []
        for (col in t.columns) {
            decl += "        val c${c}: ${kealType(col.ty())} = ${cellExpr(col.ty(), c)}\n"
            names.add("c${c}")
            c += 1
        }
        build = "${q.rowTable}(${names.join(", ")})"
    } else if (q.kind == "count") {
        build = "spiInt(i, 0)"
    } else if (q.kind == "exists") {
        build = "spiBool(i, 0)"
    } else if (q.kind != "none") {
        var c = 0
        val names: List<String> = []
        for (ty in q.colTys) {
            decl += "        val c${c}: ${kealType(ty)} = ${cellExpr(ty, c)}\n"
            names.add("c${c}")
            c += 1
        }
        build = if (names.size == 1) { names[0] } else { "${rowRecord(q)}(${names.join(", ")})" }
    }
    when (q.kind) {
        "none" -> {}
        "list" -> {
            out += "    val out: List<${one}> = []\n"
            out += "    var i = 0\n"
            out += "    while (i < spiRows()) {\n"
            out += decl
            out += "        out.add(${build})\n"
            out += "        i += 1\n"
            out += "    }\n"
            out += "    return out\n"
        }
        "first" -> {
            out += "    if (spiRows() == 0) { return null }\n"
            out += "    val i = 0\n"
            out += decl
            out += "    return ${build}\n"
        }
        else -> {
            // single, row, count, exists: exactly one row
            out += "    if (spiRows() != 1) { throw \"${q.name}: expected one row, got \" + spiRows() }\n"
            out += "    val i = 0\n"
            out += decl
            out += "    return ${build}\n"
        }
    }
    out += "}\n\n"
    return out
}

/// The C half of the bridge: one plan per query, prepared on first use and
/// kept; arguments gathered as text and converted by each type's input
/// function; every run in a subtransaction under PG_TRY, so an error is
/// rolled back and handed to Keal as a message rather than thrown through it.
func spiBridge(queries: List<QueryInfo>): String {
    var out = "#include \"executor/spi.h\"\n#include \"access/xact.h\"\n#include \"utils/memutils.h\"\n#include \"utils/lsyscache.h\"\n#include \"utils/resowner.h\"\n\n"
    out += "#define PLKEAL_NQ ${queries.size}\n"
    out += "#define PLKEAL_MAXARGS 32\n"
    out += "static const char* plkeal_sql[PLKEAL_NQ] = {\n"
    for (q in queries) { out += "    \"${cEscape(q.sql)}\",\n" }
    out += "};\n"
    out += "static const int plkeal_nargs[PLKEAL_NQ] = { ${queries.map({ "" + it.params.size }).join(", ")} };\n"
    out += "static const char* plkeal_argtypes[PLKEAL_NQ][PLKEAL_MAXARGS] = {\n"
    for (q in queries) { out += "    { ${q.params.map({ "\"" + it.sqlType + "\"" }).join(", ")} },\n" }
    out += "};\n"
    out += """static SPIPlanPtr plkeal_plans[PLKEAL_NQ];
static Oid plkeal_argoids[PLKEAL_NQ][PLKEAL_MAXARGS];

static char* plkeal_args[PLKEAL_MAXARGS];
static bool plkeal_arg_null[PLKEAL_MAXARGS];
static int plkeal_argc;
static char** plkeal_cells;
static bool* plkeal_nulls;
static int64_t plkeal_nrows;
static int64_t plkeal_ncols;
static char* plkeal_err;

static void plkeal_free_result(void) {
    if (plkeal_cells) {
        for (int64_t k = 0; k < plkeal_nrows * plkeal_ncols; k++) { free(plkeal_cells[k]); }
        free(plkeal_cells); free(plkeal_nulls);
    }
    plkeal_cells = NULL; plkeal_nulls = NULL; plkeal_nrows = 0; plkeal_ncols = 0;
}

static void plkeal_reset_args(void) {
    for (int k = 0; k < plkeal_argc; k++) { free(plkeal_args[k]); plkeal_args[k] = NULL; }
    plkeal_argc = 0;
}

/* Between two calls of a stored function nothing of the last result may survive. */
static void plkeal_spi_reset(void) {
    plkeal_free_result();
    plkeal_reset_args();
    free(plkeal_err); plkeal_err = NULL;
}

void plkeal_spi_arg(const char* s) {
    if (plkeal_argc < PLKEAL_MAXARGS) { plkeal_args[plkeal_argc] = strdup(s); plkeal_arg_null[plkeal_argc] = false; }
    plkeal_argc++;
}

void plkeal_spi_arg_null(void) {
    if (plkeal_argc < PLKEAL_MAXARGS) { plkeal_args[plkeal_argc] = NULL; plkeal_arg_null[plkeal_argc] = true; }
    plkeal_argc++;
}

bool plkeal_spi_failed(void) { return plkeal_err != NULL; }
char* plkeal_spi_message(void) { return strdup(plkeal_err ? plkeal_err : ""); }
int64_t plkeal_spi_rows(void) { return plkeal_nrows; }

static const char* plkeal_cell(int64_t row, int64_t col) {
    if (row < 0 || row >= plkeal_nrows || col < 0 || col >= plkeal_ncols) { return NULL; }
    return plkeal_cells[row * plkeal_ncols + col];
}
bool plkeal_spi_is_null(int64_t row, int64_t col) { return plkeal_cell(row, col) == NULL; }
char* plkeal_spi_str(int64_t row, int64_t col) { const char* c = plkeal_cell(row, col); return strdup(c ? c : ""); }
int64_t plkeal_spi_int(int64_t row, int64_t col) { const char* c = plkeal_cell(row, col); return c ? strtoll(c, NULL, 10) : 0; }
double plkeal_spi_float(int64_t row, int64_t col) { const char* c = plkeal_cell(row, col); return c ? strtod(c, NULL) : 0.0; }
bool plkeal_spi_bool(int64_t row, int64_t col) { const char* c = plkeal_cell(row, col); return c && c[0] == 't'; }

void plkeal_spi_run(int64_t slot) {
    plkeal_free_result();
    free(plkeal_err); plkeal_err = NULL;
    if (slot < 0 || slot >= PLKEAL_NQ) { plkeal_err = strdup("no such query"); plkeal_reset_args(); return; }
    int n = plkeal_nargs[slot];
    if (plkeal_argc != n) { plkeal_err = strdup("wrong number of arguments"); plkeal_reset_args(); return; }
    MemoryContext oldctx = CurrentMemoryContext;
    ResourceOwner oldowner = CurrentResourceOwner;
    BeginInternalSubTransaction(NULL);
    MemoryContextSwitchTo(oldctx);
    PG_TRY();
    {
        if (plkeal_plans[slot] == NULL) {
            for (int k = 0; k < n; k++) {
                plkeal_argoids[slot][k] = DatumGetObjectId(DirectFunctionCall1(regtypein, CStringGetDatum(plkeal_argtypes[slot][k])));
            }
            SPIPlanPtr p = SPI_prepare(plkeal_sql[slot], n, plkeal_argoids[slot]);
            if (p == NULL) { elog(ERROR, "SPI_prepare: %s", SPI_result_code_string(SPI_result)); }
            SPI_keepplan(p);
            plkeal_plans[slot] = p;
        }
        Datum values[PLKEAL_MAXARGS];
        char nulls[PLKEAL_MAXARGS];
        for (int k = 0; k < n; k++) {
            if (plkeal_arg_null[k]) { values[k] = (Datum)0; nulls[k] = 'n'; continue; }
            Oid infunc, ioparam;
            getTypeInputInfo(plkeal_argoids[slot][k], &infunc, &ioparam);
            values[k] = OidInputFunctionCall(infunc, plkeal_args[k], ioparam, -1);
            nulls[k] = ' ';
        }
        int rc = SPI_execute_plan(plkeal_plans[slot], values, nulls, false, 0);
        if (rc < 0) { elog(ERROR, "SPI_execute_plan: %s", SPI_result_code_string(rc)); }
        if (SPI_tuptable != NULL) {
            int64_t nr = (int64_t)SPI_processed;
            int64_t nc = SPI_tuptable->tupdesc->natts;
            plkeal_cells = calloc((size_t)(nr * nc + 1), sizeof(char*));
            plkeal_nulls = calloc((size_t)(nr * nc + 1), sizeof(bool));
            for (int64_t r = 0; r < nr; r++) {
                for (int64_t c = 0; c < nc; c++) {
                    char* v = SPI_getvalue(SPI_tuptable->vals[r], SPI_tuptable->tupdesc, (int)c + 1);
                    plkeal_cells[r * nc + c] = v ? strdup(v) : NULL;
                    if (v) { pfree(v); }
                }
            }
            plkeal_nrows = nr; plkeal_ncols = nc;
            SPI_freetuptable(SPI_tuptable);
        } else {
            plkeal_nrows = (int64_t)SPI_processed; plkeal_ncols = 0;
        }
        ReleaseCurrentSubTransaction();
        MemoryContextSwitchTo(oldctx);
        CurrentResourceOwner = oldowner;
    }
    PG_CATCH();
    {
        MemoryContextSwitchTo(oldctx);
        ErrorData* edata = CopyErrorData();
        FlushErrorState();
        RollbackAndReleaseCurrentSubTransaction();
        MemoryContextSwitchTo(oldctx);
        CurrentResourceOwner = oldowner;
        plkeal_free_result();
        plkeal_err = strdup(edata->message ? edata->message : "error");
        FreeErrorData(edata);
    }
    PG_END_TRY();
    plkeal_reset_args();
}

"""
    return out
}

package func plkealBuildScript(stem: String): String {
    var s = "#!/usr/bin/env sh\n"
    s += "# Builds ${stem}.so from ${stem}.keal: Keal to C, then the C compiler against\n"
    s += "# PostgreSQL's server headers. KEAL names the toolchain; pg_config must be on the path.\n"
    s += "set -e\n"
    s += "cd \"$(dirname \"$0\")\"\n"
    s += "KEAL=\"$" + "{KEAL:-keal}\"\n"
    s += "\"$" + "KEAL\" emit-c ${stem}.keal > ${stem}.c\n"
    s += "$" + "{CC:-cc} -shared -fPIC -O2 -std=gnu11 -D_GNU_SOURCE -I\"$(pg_config --includedir-server)\" -o ${stem}.so ${stem}.c\n"
    s += "echo \"${stem}.so\"\n"
    return s
}

/// Writes DIR/<stem>.keal and DIR/build.sh; answers what it wrote.
package func writePlkeal(compiler: Compiler, dir: String): List<String> {
    if (compiler.program.stored.isEmpty()) {
        println("error: ${compiler.file} declares no stored function")
        exit(1)
    }
    unless (makeDir(dir)) {
        println("error: cannot create `${dir}`")
        exit(1)
    }
    val stem = compiler.libStem()
    val keal = "${dir}/${stem}.keal"
    val build = "${dir}/build.sh"
    unless (writeFile(keal, plkealSource(compiler)) and writeFile(build, plkealBuildScript(stem))) {
        println("error: cannot write into `${dir}`")
        exit(1)
    }
    runCommand(["chmod", "+x", build])
    return [keal, build]
}
