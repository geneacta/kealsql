// What a live PostgreSQL database holds, read through `psql` from
// pg_catalog. One round trip: a script of four SELECTs, each row tagged
// with the kind of thing it describes, parsed back into the model below.
// Names are the catalog's own: lower case, unquoted.

package class LiveColumn(package val name: String, package val ty: String, package val notNull: Bool, package val default: String)

/// kind: "p" primary key, "u" unique, "f" foreign key, "c" check. Actions
/// are the catalog's letters: a no action, r restrict, c cascade, n set null.
package class LiveConstraint(package val kind: String, package val name: String, package val cols: List<String>) {
    package var refTable: String = ""
    package var refCols: List<String> = []
    package var onDelete: String = "a"
    package var onUpdate: String = "a"
    package var def: String = ""             // a check's definition, as pg_get_constraintdef prints it
}

/// A plain index — not one a key or a unique constraint owns.
package class LiveIndex(package val name: String, package val cols: List<String>)

package class LiveTable(package val name: String) {
    package var columns: List<LiveColumn> = []
    package var constraints: List<LiveConstraint> = []
    package var indexes: List<LiveIndex> = []

    package func column(name: String): LiveColumn? { this.columns.find({ it.name == name }) }
}

/// A view, by name, with the fingerprint KealSql left as its comment ("" when
/// it was not KealSql that made it).
package class LiveView(package val name: String, package val fingerprint: String, package val materialized: Bool)

/// A function KealSql made (its C symbol is `kealsql_...`), and a trigger.
package class LiveFunction(package val name: String, package val args: String, package val result: String, package val lib: String, package val symbol: String)
package class LiveTrigger(package val name: String, package val table: String, package val timing: String, package val event: String, package val function: String)

package class Live() {
    package var hasSchema: Bool = false      // the namespace exists
    package var functions: List<LiveFunction> = []
    package var triggers: List<LiveTrigger> = []
    package var views: List<LiveView> = []
    package var enums: Map<String, List<String>> = {}
    package var enumOrder: List<String> = []
    package var tables: Map<String, LiveTable> = {}
    package var tableOrder: List<String> = []
}

func catalogScript(ns: String): String { return """
SELECT 'S', nspname FROM pg_namespace WHERE nspname = 'NS';
SELECT 'E', t.typname, e.enumlabel
FROM pg_type t JOIN pg_enum e ON e.enumtypid = t.oid
WHERE t.typnamespace = 'NS'::regnamespace
ORDER BY t.typname, e.enumsortorder;
SELECT 'T', c.relname
FROM pg_class c
WHERE c.relkind = 'r' AND c.relnamespace = 'NS'::regnamespace
ORDER BY c.relname;
SELECT 'C', c.relname, a.attname, format_type(a.atttypid, a.atttypmod), a.attnotnull,
       coalesce((SELECT pg_get_expr(d.adbin, d.adrelid) FROM pg_attrdef d WHERE d.adrelid = a.attrelid AND d.adnum = a.attnum), '')
FROM pg_attribute a JOIN pg_class c ON c.oid = a.attrelid
WHERE c.relkind = 'r' AND c.relnamespace = 'NS'::regnamespace AND a.attnum > 0 AND NOT a.attisdropped
ORDER BY c.relname, a.attnum;
SELECT 'K', c.relname, k.contype, k.conname,
       coalesce((SELECT string_agg(a.attname, ',' ORDER BY x.ord) FROM unnest(k.conkey) WITH ORDINALITY x(attnum, ord)
          JOIN pg_attribute a ON a.attrelid = k.conrelid AND a.attnum = x.attnum), ''),
       coalesce(r.relname, ''),
       coalesce((SELECT string_agg(a.attname, ',' ORDER BY x.ord) FROM unnest(k.confkey) WITH ORDINALITY x(attnum, ord)
          JOIN pg_attribute a ON a.attrelid = k.confrelid AND a.attnum = x.attnum), ''),
       k.confdeltype, k.confupdtype,
       CASE WHEN k.contype = 'c' THEN pg_get_constraintdef(k.oid) ELSE '' END
FROM pg_constraint k JOIN pg_class c ON c.oid = k.conrelid LEFT JOIN pg_class r ON r.oid = k.confrelid
WHERE k.contype IN ('p', 'u', 'f', 'c') AND c.relnamespace = 'NS'::regnamespace
ORDER BY c.relname, k.conname;
SELECT 'V', c.relname, coalesce(obj_description(c.oid, 'pg_class'), ''), c.relkind
FROM pg_class c
WHERE c.relkind IN ('v', 'm') AND c.relnamespace = 'NS'::regnamespace
ORDER BY c.relname;
SELECT 'F', p.proname, pg_get_function_arguments(p.oid), pg_get_function_result(p.oid), coalesce(p.probin, ''), p.prosrc
FROM pg_proc p
WHERE p.pronamespace = 'NS'::regnamespace AND p.prosrc LIKE 'kealsql\_%'
ORDER BY p.proname;
SELECT 'G', t.tgname, c.relname,
       CASE WHEN (t.tgtype & 2) = 2 THEN 'before' ELSE 'after' END,
       CASE WHEN (t.tgtype & 4) = 4 THEN 'insert' WHEN (t.tgtype & 8) = 8 THEN 'delete' ELSE 'update' END,
       p.proname
FROM pg_trigger t JOIN pg_class c ON c.oid = t.tgrelid JOIN pg_proc p ON p.oid = t.tgfoid
WHERE NOT t.tgisinternal AND c.relnamespace = 'NS'::regnamespace
ORDER BY t.tgname;
SELECT 'I', c.relname, i.relname,
       (SELECT string_agg(a.attname, ',' ORDER BY k.ord) FROM unnest(x.indkey::int2[]) WITH ORDINALITY k(attnum, ord)
          JOIN pg_attribute a ON a.attrelid = x.indrelid AND a.attnum = k.attnum)
FROM pg_index x JOIN pg_class c ON c.oid = x.indrelid JOIN pg_class i ON i.oid = x.indexrelid
WHERE c.relnamespace = 'NS'::regnamespace AND NOT x.indisprimary AND NOT x.indisunique
ORDER BY c.relname, i.relname;
""".replace("NS", ns)
}

/// The `psql` invocation. `db` is `-d`'s argument, or "" to let the
/// PG* environment and ~/.pgpass decide, as psql itself does.
func psqlArgv(db: String): List<String> {
    val argv = ["psql", "-X", "-A", "-t", "-F", "|", "-v", "ON_ERROR_STOP=1"]
    if (db != "") { argv.add("-d"); argv.add(db) }
    return argv
}

/// Reads the database, or explains why it could not and stops.
package func readLive(db: String, ns: String): Live {
    val r = runCommand(psqlArgv(db), catalogScript(ns))
    if (r == null) {
        println("error: `psql` could not be started; is PostgreSQL's client on the path?")
        exit(1)
    }
    if (r[0] != "0") {
        println("error: psql failed reading the catalog" + (if (db != "") { " of `${db}`" } else { "" }))
        for (l in lines(r[2])) { if (l != "") { println("  ${l}") } }
        exit(1)
    }
    // psql on Windows writes CRLF; a `\r` glued to the last field of every line
    // would make `Draft` six characters long. Tool output is normalised here,
    // at the boundary, before anything reads it.
    return parseLive(r[1].replace("\r", ""))
}

package func parseLive(text: String): Live {
    val live = Live()
    for (line in lines(text)) {
        if (line == "") { continue }
        val f = line.split("|")
        when (f[0]) {
            "E" -> {
                val labels = live.enums[f[1]]
                if (labels == null) {
                    live.enums.set(f[1], [f[2]])
                    live.enumOrder.add(f[1])
                } else {
                    labels.add(f[2])
                }
            }
            "T" -> {
                live.tables.set(f[1], LiveTable(f[1]))
                live.tableOrder.add(f[1])
            }
            "C" -> {
                val t = live.tables[f[1]]
                if (t != null) { t.columns.add(LiveColumn(f[2], f[3], f[4] == "t", f[5])) }
            }
            "K" -> {
                val t = live.tables[f[1]]
                if (t != null) {
                    val k = LiveConstraint(f[2], f[3], if (f[4] == "") { [] } else { f[4].split(",") })
                    k.refTable = f[5]
                    k.refCols = if (f[6] == "") { [] } else { f[6].split(",") }
                    k.onDelete = f[7]
                    k.onUpdate = f[8]
                    if (f.size > 9) { k.def = f[9] }
                    t.constraints.add(k)
                }
            }
            "I" -> {
                val t = live.tables[f[1]]
                if (t != null) { t.indexes.add(LiveIndex(f[2], f[3].split(","))) }
            }
            "V" -> { live.views.add(LiveView(f[1], f[2], f[3] == "m")) }
            "S" -> { live.hasSchema = true }
            "F" -> { live.functions.add(LiveFunction(f[1], f[2], f[3], f[4], f[5])) }
            "G" -> { live.triggers.add(LiveTrigger(f[1], f[2], f[3], f[4], f[5])) }
            else -> {}
        }
    }
    return live
}
